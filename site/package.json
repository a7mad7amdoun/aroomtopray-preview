    "astro": "^5.18.2"
  },
  "devDependencies": {
    "d3-geo": "^3.1.1",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.149.0"
  }
