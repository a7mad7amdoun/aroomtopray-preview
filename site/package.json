{
  "name": "aroomtopray",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "art": "node scripts/art.mjs",
    "dev": "pnpm data && astro dev --host 127.0.0.1",
