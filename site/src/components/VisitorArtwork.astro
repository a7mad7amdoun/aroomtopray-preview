---
import SettingGallery from './SettingGallery.astro';
import DocumentaryArtwork from './DocumentaryArtwork.astro';
const { scene, locale='en', placement='guide', purpose='visit-context' }=Astro.props;
if (!['airport','campus','hospital'].includes(scene)) throw new Error('Unknown visitor artwork: '+scene);
---
{placement==='guide'?<SettingGallery {scene} {locale}/>:<DocumentaryArtwork {scene} {locale} {placement} {purpose}/>}
