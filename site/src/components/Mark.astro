---
// The logo mark on its yellow tile: a pointed mihrab arch with a "straight ahead" arrow, standing on a mat line.
const { size = 36 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="9" fill="var(--sign)"/><svg x="5" y="4.5" width="30" height="30" viewBox="0 0 40 40"><use href="#i-mark" color="var(--sign-ink)"/></svg></svg>
