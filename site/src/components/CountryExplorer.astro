---
import {airports} from '../lib/airports.js';
import {universities} from '../lib/universities.js';
import {hospitals} from '../lib/hospitals.js';
import CountryFlag from './CountryFlag.astro';
import {COUNTRY_CODES,countryCode,countryName,countrySearchText} from '../lib/countries.js';
import {getCopy,localizedPath,formatCount} from '../lib/i18n.js';
import {GUIDE_COPY} from '../data/guide-copy.js';
const {locale='en'}=Astro.props,t=getCopy(locale),g=GUIDE_COPY[locale];
const kinds=['airports','universities','hospitals'],icons=['airport','campus','care'];
const coverage={
 en:{all:'All countries and territories',covered:'With places in this guide',scope:'Show',empty:'No places listed here yet.',summary:'{covered} covered · {all} countries and territories'},
 fr:{all:'Tous les pays et territoires',covered:'Avec des lieux dans ce guide',scope:'Afficher',empty:'Aucun lieu répertorié ici pour le moment.',summary:'{covered} couverts · {all} pays et territoires'},
 ar:{all:'جميع البلدان والأقاليم',covered:'بلدان فيها أماكن مدرجة',scope:'عرض',empty:'لا توجد أماكن مدرجة هنا حتى الآن.',summary:'{covered} مشمولة بالدليل · {all} بلداً وإقليماً'},
 es:{all:'Todos los países y territorios',covered:'Con lugares en esta guía',scope:'Mostrar',empty:'Aún no hay lugares registrados aquí.',summary:'{covered} con cobertura · {all} países y territorios'},
}[locale];
const countries=new Map(COUNTRY_CODES.map(code=>[code,{code,name:countryName(code,locale),counts:[0,0,0]}]));
[airports,universities,hospitals].forEach((places,i)=>places.forEach(p=>{
 const code=countryCode(p.country);
 if(!countries.has(code))throw new Error('Unknown country in directory: '+p.country);
 countries.get(code).counts[i]++;
}));
const rows=[...countries.values()].sort((a,b)=>a.name.localeCompare(b.name,locale));
const covered=rows.filter(row=>row.counts.some(Boolean)).length;
const resultTemplate={en:'{count} of {total} countries and territories',fr:'{count} sur {total} pays et territoires',ar:'عرض {count} من {total} بلدًا وإقليمًا',es:'{count} de {total} países y territorios'}[locale];
---
<section class="country-explorer" data-country-explorer data-locale={locale} data-result-template={resultTemplate}>
 <header class="panel-heading"><span class="guide-kicker"><svg width="18" height="18" aria-hidden="true"><use href="#i-globe"/></svg>{coverage.summary.replace('{covered}',formatCount(covered,locale)).replace('{all}',formatCount(rows.length,locale))}</span><h2>{g.countryIntro}</h2></header>
 <div class="country-explorer-controls"><label class="country-scope" data-country-scope-control hidden><span>{coverage.scope}</span><select data-country-scope><option value="covered">{coverage.covered}</option><option value="all">{coverage.all}</option></select></label>
 <label class="country-search"><svg width="20" height="20" aria-hidden="true"><use href="#i-search"/></svg><span class="sr">{g.countrySearch}</span><input type="search" placeholder={g.countrySearch} maxlength="160" data-country-search /></label></div>
 <div class="country-results-status"><p class="country-search-status fine" data-country-status role="status" aria-atomic="true"></p><button class="clear" type="button" data-country-clear hidden>{t.common.clear}</button></div>
 <div class="country-grid">{rows.map(row=><article class="country-card" data-country-card data-country-covered={row.counts.some(Boolean)} data-country-text={countrySearchText(row.code)} hidden={!row.counts.some(Boolean)}><h3><CountryFlag country={row.code}/><span>{row.name}</span><small>{row.code}</small></h3><div>{row.counts.map((count,i)=>count>0&&<a href={`${localizedPath('/'+kinds[i]+'/',locale)}?country=${row.code}&mode=list`}><svg width="17" height="17" aria-hidden="true"><use href={`#i-${icons[i]}`}/></svg><span>{t.nav[kinds[i]]}</span><b>{formatCount(count,locale)}</b><svg class="directional-icon" width="15" height="15" aria-hidden="true"><use href="#i-arrow"/></svg></a>)}</div>{!row.counts.some(Boolean)&&<p class="country-coverage-note">{coverage.empty}</p>}</article>)}</div>
 <p data-country-empty hidden>{g.noCountries}</p>
 <button class="country-more btn" type="button" data-country-more hidden>{{en:'Show more countries',fr:'Afficher plus de pays',ar:'عرض المزيد من البلدان',es:'Mostrar más países'}[locale]}</button>
</section>
<script>
 import '../scripts/country-explorer.js';
</script>
<style>
 .country-more { margin-top:24px; min-height:48px; }
 .country-explorer-controls { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:12px; align-items:end; }
 .country-explorer-controls .country-scope { display:grid; grid-column:2; grid-row:1; gap:6px; margin:0; color:var(--muted); font-size:.75rem; }
 .country-explorer-controls .country-scope select { width:100%; min-height:52px; border-color:var(--field); border-radius:10px; font-size:.85rem; color:var(--ink); }
 .country-explorer-controls .country-search { grid-column:1; grid-row:1; min-height:52px; border-radius:10px; }
 .country-explorer-controls .country-search input { min-height:50px; font-size:.95rem; }
 .country-explorer .country-grid { grid-template-columns:repeat(3,minmax(0,1fr)); max-height:none; overflow:visible; gap:16px; padding:0; }
 .country-explorer .country-card { display:flex; flex-direction:column; border-radius:14px; padding:20px; background:var(--surface); }
 .country-explorer .country-card[hidden] { display:none; }
 .country-explorer .country-card h3 { display:grid; grid-template-columns:48px minmax(0,1fr); gap:12px; align-items:center; margin:0 0 20px; font:600 1rem/1.4 var(--f-display); }
 .country-explorer .country-card :global(img.country-flag) { width:48px; height:36px; padding:0; border-radius:3px; background:transparent; box-shadow:0 0 0 1px var(--line); }
 .country-explorer .country-card>div { margin-top:auto; }
 .country-explorer .country-card a { gap:8px; padding-block:10px; min-height:44px; font-size:.82rem; border-color:var(--line); }
 .country-explorer .country-card a>b { min-width:24px; padding:2px 5px; text-align:center; border-radius:5px; font-size:.75rem; font-weight:600; font-variant-numeric:tabular-nums; color:var(--ink); background:var(--surface-2); }
 .country-explorer .country-card a>svg:last-child { color:var(--muted); }
 .country-explorer .country-coverage-note { margin:0; padding-top:12px; border-top:1px solid var(--line); font-size:.8rem; color:var(--muted); }
 @container prayer-guide (max-width:900px) { .country-explorer .country-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
 @container prayer-guide (max-width:540px) {
  .country-explorer-controls { grid-template-columns:1fr; gap:14px; }
  .country-explorer-controls .country-search { grid-row:1; grid-column:1; }
  .country-explorer-controls .country-scope { grid-row:2; grid-column:1; grid-template-columns:auto minmax(0,1fr); align-items:center; gap:12px; }
  .country-explorer-controls .country-scope select { min-height:44px; }
  .country-explorer .country-grid { grid-template-columns:1fr; }
 }
 :global(html[dir=rtl]) .country-explorer .country-card h3 { font-family:var(--f-arabic); line-height:1.6; }
 .country-results-status { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:4px 12px; min-height:44px; }
 .country-results-status p { margin:0; padding:0; }
 .country-results-status button { min-height:44px; padding:8px 10px; }
</style>
