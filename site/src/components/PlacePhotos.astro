---
import { photosForPlace, photoSearchUrl, linkedPhotoSources, photoSrcset } from '../lib/place-photos.js';
import { PHOTO_COPY } from '../data/photo-copy.js';
import { PRESENTATION_COPY } from '../data/presentation-copy.js';
import PhotoViewer from './PhotoViewer.astro';
const { place, locale='en' } = Astro.props;
const t=PHOTO_COPY[locale] || PHOTO_COPY.en, photos=photosForPlace(place.url), sources=linkedPhotoSources(place);
const v=PRESENTATION_COPY[locale] || PRESENTATION_COPY.en;
const date = value => new Intl.DateTimeFormat(locale,{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(`${value}T12:00:00Z`));
---
<section id="place-photos" class:list={['place-photos',{'has-photos':photos.length>0}]} data-photo-place={place.url} data-photo-viewer aria-label={photos.length?t.title:t.find}>
 {photos.length>0 && <>
  <header><span class="photo-heading-icon" aria-hidden="true"><svg width="24" height="24"><use href="#i-photo"/></svg></span><div><span class="guide-kicker">{t.badge}</span><h2>{t.title}</h2><p class="photo-caveat">{t.historical}</p></div></header>
  <div class="place-photo-grid">{photos.map(photo=><figure data-photo-id={photo.id}>
   <a class="place-photo-image" href={photo.sourceUrl} target="_blank" rel="noopener noreferrer" data-photo-open data-photo-width={photo.images.at(-1).width} data-photo-label={`${v.enlarge}: ${photo.caption[locale] || photo.caption.en}`} aria-label={`${t.original}: ${photo.caption[locale] || photo.caption.en}`}>
    <img src={photo.images.at(-1).src} srcset={photoSrcset(photo)} sizes="(max-width: 1200px) calc(100vw - 100px), 1040px" width={photo.width} height={photo.height} alt={photo.alt[locale] || photo.alt.en} loading="lazy" decoding="async"/>
    <span class="photo-enlarge" data-photo-hint hidden><svg width="17" height="17" aria-hidden="true"><use href="#i-focus"/></svg>{v.enlarge}</span>
   </a>
   <figcaption>
    <span class="photo-kind">{t.kinds[photo.kind]}</span>
    <p>{photo.caption[locale] || photo.caption.en}</p>
    {photo.kind==='exterior'&&<p class="photo-caveat">{t.context}</p>}
    <p class="photo-date">{t.captured} <time datetime={photo.dateTaken}>{date(photo.dateTaken)}</time></p>
    <div class="photo-credit"><span>© <bdi>{photo.author}</bdi></span><a href={photo.sourceUrl} target="_blank" rel="noopener noreferrer">{t.original} ↗</a><a href={photo.license.url} target="_blank" rel="license noopener noreferrer">{photo.license.name}</a></div>
    <small class="photo-processing">{t.changes}</small>
   </figcaption>
  </figure>)}</div>
 </>}
 <details class="photo-research">
  <summary><svg width="19" height="19" aria-hidden="true"><use href="#i-photo"/></svg><span>{photos.length?t.more:t.find}</span></summary>
  {!photos.length&&<p>{t.empty}</p>}
  <a class="photo-search-link" href={photoSearchUrl(place)} target="_blank" rel="noopener noreferrer">{t.search} <span aria-hidden="true">↗</span></a>
  <p class="photo-search-place"><bdi>{place.name}</bdi> · <bdi>{place.city}</bdi></p>
  <p class="photo-caveat">{t.searchNote}</p>
  {sources.length>0&&<><h3>{t.sources}</h3><ul>{sources.map(url=><li><a href={url} target="_blank" rel="noopener noreferrer"><bdi>{new URL(url).hostname.replace(/^www\./,'')}</bdi><span aria-hidden="true"> ↗</span></a></li>)}</ul></>}
 </details>
 {photos.length>0&&<PhotoViewer {locale}/>}
</section>
<style>
 .place-photos { margin-block:20px; min-width:0; scroll-margin-top:7rem; }
 .place-photos.has-photos { padding-block:24px 8px; border-top:1px solid var(--line); }
 header { display:flex; align-items:flex-start; gap:14px; margin-bottom:22px; }
 .photo-heading-icon { display:grid; place-items:center; width:44px; height:44px; flex:none; color:var(--sign-ink); background:var(--sign); border-radius:4px; }
 h2 { margin:5px 0 10px; font-size:clamp(1.25rem,2vw,1.6rem); line-height:1.25; }
 .photo-caveat { color:var(--muted); font-size:.88rem; line-height:1.65; max-width:70ch; }
 .place-photo-grid { display:grid; gap:24px; margin-bottom:20px; }
 figure { display:grid; gap:20px; margin:0; min-width:0; padding:0; overflow:hidden; border:1px solid var(--line); border-radius:12px; background:color-mix(in srgb,var(--surface) 78%,transparent); box-shadow:none; }
 .place-photo-image { display:grid; align-items:center; align-self:start; border:0; background:var(--surface-2); border-radius:0; overflow:hidden; }
 .place-photo-image img { display:block; width:100%; height:auto; max-height:680px; object-fit:contain; filter:none; }
 .place-photo-image[role=button] { cursor:zoom-in; text-decoration:none; }
 .photo-enlarge { display:flex; align-items:center; justify-content:center; gap:8px; min-height:44px; padding:8px 12px; border-top:1px solid var(--line); color:var(--ink); font:600 .8rem/1.4 var(--f-body); }
 .photo-enlarge svg { flex:none; }
 .place-photo-image[role=button]:hover .photo-enlarge { background:var(--sign); color:var(--sign-ink); }
 figcaption { min-width:0; padding:0 24px 24px; max-width:78ch; } figcaption p { margin:10px 0; line-height:1.6; }
 .photo-kind { color:var(--ink); font-size:.75rem; font-weight:700; padding:4px 8px; background:var(--surface-2); border:1px solid var(--line); border-radius:3px; }
 .photo-date,.photo-credit,.photo-processing { font-size:.8rem; color:var(--muted); line-height:1.65; }
 .photo-credit { display:flex; flex-wrap:wrap; gap:4px 14px; }.photo-credit a { text-underline-offset:3px; }
 .photo-processing { display:block; margin-top:6px; }
 .photo-research { border:1px solid var(--line); background:var(--surface); border-radius:6px; padding:0 16px; }
 .has-photos .photo-research { background:var(--surface-2); }
 summary { cursor:pointer; min-height:52px; padding-block:14px; font-weight:600; line-height:1.5; }
 summary svg { vertical-align:middle; margin-inline:8px; } summary span { vertical-align:middle; }
 summary:hover { text-decoration:underline; text-underline-offset:4px; }
 .photo-research[open] { padding-bottom:16px; } .photo-research p { margin-block:10px; }
 .photo-search-link { display:inline-flex; gap:12px; align-items:center; min-height:44px; font-weight:600; }
 .photo-search-place { font-size:.85rem; overflow-wrap:anywhere; }
 h3 { font-size:.85rem; margin:20px 0 6px; } ul { padding-inline-start:20px; margin:0; }
 li { font-size:.82rem; overflow-wrap:anywhere; } li a { display:inline-block; padding-block:8px; }
 a:focus-visible,summary:focus-visible { outline:3px solid var(--focus); outline-offset:4px; }
 :global(html[lang=ar]) h2 { line-height:1.65; } :global(html[lang=ar]) .photo-caveat { line-height:1.9; }
 @media print { figure { break-inside:avoid; box-shadow:none; } }
</style>
