---
import { RECEPTION_COPY, RECEPTION_LANGUAGES, RECEPTION_PHRASES } from '../data/reception-copy.js';
interface Props { locale?: string; id?: string }
const {locale='en',id='reception-directions'}=Astro.props;
const language=Object.hasOwn(RECEPTION_COPY,locale)?locale:'en';
const t=RECEPTION_COPY[language];
const direction=language==='ar'?'rtl':'ltr';
---
<div class="reception-card" data-reception data-reception-id={id} data-locale={language}>
 <button class="reception-trigger" type="button" data-reception-open hidden aria-haspopup="dialog" aria-controls={`${id}-dialog`}><svg width="19" height="19" aria-hidden="true"><use href="#i-help"/></svg><span>{t.open}</span></button>
 <details class="reception-fallback" data-reception-fallback>
  <summary><svg width="19" height="19" aria-hidden="true"><use href="#i-help"/></svg>{t.open}</summary>
  <p>{t.fallback}</p>
  <div class="reception-fallback-phrases">{RECEPTION_LANGUAGES.map(item=><section lang={item.code} dir={item.dir}><h3>{item.name}</h3><p>{RECEPTION_PHRASES[item.code]}</p></section>)}</div>
 </details>
 <dialog class="reception-dialog" id={`${id}-dialog`} data-reception-dialog aria-labelledby={`${id}-title`} aria-describedby={`${id}-help`} lang={language} dir={direction}>
  <div class="reception-shell">
   <header class="reception-heading"><div><span class="reception-eyebrow">{t.label}</span><h2 id={`${id}-title`}>{t.title}</h2></div><button type="button" class="reception-close" data-reception-close autofocus><svg width="19" height="19" aria-hidden="true"><use href="#i-close"/></svg><span>{t.close}</span></button></header>
   <p id={`${id}-help`} class="reception-help">{t.help}</p>
   <label class="reception-language"><span>{t.language}</span><select data-reception-language>{RECEPTION_LANGUAGES.map(item=><option value={item.code} lang={item.code} selected={item.code===language}>{item.name}</option>)}</select></label>
   <div class="reception-message"><svg class="reception-mark" width="28" height="28" aria-hidden="true"><use href="#i-mark"/></svg><p data-reception-phrase lang={language} dir={direction} tabindex="-1" aria-live="polite" aria-atomic="true">{RECEPTION_PHRASES[language]}</p></div>
   <footer class="reception-actions"><button class="reception-copy" type="button" data-reception-copy><svg width="18" height="18" aria-hidden="true"><use href="#i-copy"/></svg>{t.copy}</button><p class="reception-status" data-reception-status role="status" aria-live="polite" aria-atomic="true"></p></footer>
  </div>
 </dialog>
</div>
<script>
 import {initReceptionCard} from '../scripts/reception-card.js';
 document.querySelectorAll('[data-reception]').forEach(root=>initReceptionCard(root));
</script>
<style>
 .reception-card { min-width:0; color:var(--ink); font-family:var(--f-body); pointer-events:auto; }
 .reception-trigger,.reception-fallback>summary { display:inline-flex; align-items:center; justify-content:center; gap:9px; min-height:44px; padding:10px 14px; border:1px solid var(--line); border-radius:9px; background:var(--surface); color:var(--ink); font:600 .82rem/1.4 var(--f-body); cursor:pointer; text-decoration:none; }
 .reception-trigger svg,.reception-fallback>summary svg { flex:none; }
 .reception-trigger:hover,.reception-fallback>summary:hover { border-color:var(--field); background:var(--surface-2); }
 .reception-fallback { max-width:680px; }
 .reception-fallback>summary::-webkit-details-marker { display:none; }
 .reception-fallback>p { margin:16px 0; font-size:.88rem; color:var(--muted); }
 .reception-fallback-phrases { display:grid; gap:12px; }
 .reception-fallback-phrases section { padding:20px; background:var(--surface); border:1px solid var(--line); border-radius:12px; }
 .reception-fallback-phrases h3 { margin:0 0 10px; font:600 .8rem/1.5 var(--f-body); color:var(--muted); }
 .reception-fallback-phrases p { margin:0; font-size:1.25rem; line-height:1.6; }
 .reception-dialog { width:min(720px,calc(100vw - 32px)); max-width:none; max-height:calc(100dvh - 32px); margin:auto; padding:0; overflow:auto; overscroll-behavior:contain; border:1px solid var(--field); border-radius:20px; color:var(--ink); background:var(--surface); box-shadow:0 24px 100px #0005; text-align:start; }
 .reception-dialog:not([open]) { display:none; }
 .reception-dialog::backdrop { background:#07101cba; }
 .reception-shell { padding:clamp(20px,4vw,36px); }
 .reception-heading { display:flex; align-items:start; justify-content:space-between; gap:20px; margin:0; }
 .reception-eyebrow { color:var(--muted); font-size:.72rem; font-weight:600; line-height:1.5; }
 .reception-heading h2 { margin:8px 0 0; max-width:24ch; font:600 clamp(1.2rem,3vw,1.55rem)/1.3 var(--f-display); letter-spacing:-.025em; }
 .reception-close { display:inline-flex; align-items:center; justify-content:center; gap:7px; flex:none; min-width:44px; min-height:44px; padding:10px; border:1px solid var(--line); border-radius:9px; color:var(--ink); background:var(--surface); cursor:pointer; font:600 .78rem/1.4 var(--f-body); }
 .reception-close:hover { background:var(--surface-2); border-color:var(--field); }
 .reception-help { margin:18px 0 22px; max-width:58ch; color:var(--muted); font-size:.88rem; line-height:1.65; }
 .reception-language { display:flex; align-items:center; justify-content:space-between; gap:16px; font-size:.78rem; color:var(--muted); }
 .reception-language select { width:auto; max-width:56%; min-height:44px; padding:9px 12px; border:1px solid var(--field); border-radius:8px; font:500 .88rem/1.5 var(--f-body); color:var(--ink); background:var(--surface); }
 .reception-message { display:grid; gap:20px; margin-top:16px; padding:clamp(24px,5vw,40px); border:1px solid var(--line); border-top:3px solid var(--sign); border-radius:12px; background:var(--surface-2); }
 .reception-mark { color:var(--ink); }
 .reception-message p { margin:0; font:500 clamp(1.7rem,5.3vw,2.6rem)/1.3 var(--f-display); letter-spacing:-.025em; overflow-wrap:anywhere; user-select:text; cursor:text; }
 .reception-message p:focus { outline:none; }
 .reception-actions { display:flex; align-items:center; flex-wrap:wrap; gap:12px 18px; margin-top:22px; }
 .reception-copy { display:inline-flex; align-items:center; justify-content:center; gap:9px; min-height:46px; padding:12px 16px; border:1px solid var(--sign); border-radius:9px; color:var(--sign-ink); background:var(--sign); font:600 .85rem/1.4 var(--f-body); cursor:pointer; }
 .reception-copy:hover { box-shadow:inset 0 0 0 1px var(--sign-ink); }
 .reception-copy:disabled { opacity:.65; cursor:wait; }
 .reception-status { flex:1; min-width:160px; margin:0; color:var(--muted); font-size:.8rem; line-height:1.6; }
 button:focus-visible,select:focus-visible,summary:focus-visible { outline:3px solid var(--focus); outline-offset:3px; }
 [lang=ar].reception-dialog :is(h2,button,select),.reception-message p[lang=ar],.reception-fallback-phrases section[lang=ar] { font-family:var(--f-arabic); letter-spacing:0; }
 .reception-message p[lang=ar] { font-size:clamp(1.9rem,5.6vw,2.8rem); line-height:1.7; }
 @media(max-width:480px) {
  .reception-dialog { width:calc(100vw - 16px); max-height:calc(100dvh - 16px); border-radius:16px; }
  .reception-heading { gap:12px; }
  .reception-close>span { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); }
  .reception-copy { width:100%; }
  .reception-message { padding:24px; }
 }
 @media print { .reception-card { display:none!important; } }
</style>
