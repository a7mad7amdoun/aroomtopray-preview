---
import { HOME_VIEW_COPY, HOME_SCENES } from '../data/home-views.js';
import { ROOM_VIEWS, ROOM_VIEW_COPY } from '../data/room-views.js';
import { ROOM_GALLERIES, ROOM_GALLERY_COPY } from '../data/room-gallery.js';
const {kind='home',locale='en',presentation='home'}=Astro.props;
const selected={airports:'airport',universities:'campus',hospitals:'hospital'}[kind];
const scenes=selected?[selected]:Object.keys(ROOM_VIEWS);
const copy=ROOM_VIEW_COPY[locale];
const home=presentation==='home', homeCopy=HOME_VIEW_COPY[locale];
const gallery=selected&&!home?ROOM_GALLERIES[selected]:null;
---
{gallery&&<p class="room-photo-credit" data-room-photo-credit-line>{gallery.map((photo,index)=><span data-room-photo-credit hidden={index!==0}><a href={photo.source} target="_blank" rel="noopener noreferrer" lang="en">{photo.title}</a><span> · <bdi>{photo.author}</bdi> · <a href={photo.licenseUrl} target="_blank" rel="noopener noreferrer">{photo.license}</a></span></span>)}</p>}
{home&&<p class="room-photo-credit room-home-photo-credit">{HOME_SCENES.map(({id,photo},index)=><span data-home-photo-credit={id} hidden={index!==0}><a href={photo.sourceUrl} target="_blank" rel="noopener noreferrer" lang="en"><bdi>{photo.title}</bdi></a><span> · <bdi>{photo.author}</bdi> · <a href={photo.license.url} target="_blank" rel="noopener noreferrer">{photo.license.name}</a></span></span>)}</p>}
<details class="room-view-credits" dir={locale==='ar'?'rtl':'ltr'}>
 <summary>{copy.credit}<svg width="16" height="16" aria-hidden="true"><use href="#i-info"/></svg></summary>
 <div class="room-view-sources">
  <p>{home?homeCopy.note:copy.note}</p>
  {home&&<ul>{HOME_SCENES.map(({photo})=><li><a href={photo.sourceUrl} lang="en"><bdi>{photo.title}</bdi></a><span><bdi>{photo.author}</bdi> · <time datetime={photo.date}>{photo.date.slice(0,4)}</time> · <a href={photo.license.url}>{photo.license.name}</a></span></li>)}</ul>}
  {!home&&<ul>{(gallery||scenes.map(scene=>ROOM_VIEWS[scene])).map(view=><li><a href={view.source} lang="en">{view.title}</a><span><bdi>{view.author}</bdi> · <time datetime={view.date}>{view.date.slice(0,4)}</time> · <a href={view.licenseUrl}>{view.license}</a></span></li>)}</ul>}
  <p>{home?homeCopy.changes:copy.changes}</p>
  {gallery&&<p>{ROOM_GALLERY_COPY[locale].treatment}</p>}
  {home&&<p><a href="https://commons.wikimedia.org/wiki/File:Allah.svg">{copy.calligraphy}</a> · Falcorian · {copy.publicDomain}</p>}
 </div>
</details>
