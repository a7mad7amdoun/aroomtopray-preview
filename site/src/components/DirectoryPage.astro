---
import Base from '../layouts/Base.astro';
import CategoryOrientation from './CategoryOrientation.astro';
import CategoryPhotoEssay from './CategoryPhotoEssay.astro';
import OfficialFieldNote from './OfficialFieldNote.astro';
import DirectoryResult from './DirectoryResult.astro';
import DirectoryToolbar from './DirectoryToolbar.astro';
import DirectoryWayfinding from './DirectoryWayfinding.astro';
import WayfindingSymbol from './WayfindingSymbol.astro';
import {countryCode,countryName} from '../lib/countries.js';
import {GUIDE_COPY} from '../data/guide-copy.js';
import { ROOM_COPY } from '../data/room-copy.js';
import { WAYFINDING_COPY } from '../data/wayfinding-copy.js';
import VisitInsights from './VisitInsights.astro';
import AirportMap from './AirportMap.astro';
import DirectoryMapPreview from './DirectoryMapPreview.astro';
import { getCopy, localizedPath, translateTerm, formatCount } from '../lib/i18n.js';
import { airports, REGIONS, halal } from '../lib/airports.js';
import { universities, COUNTRIES } from '../lib/universities.js';
import { hospitals, H_COUNTRIES } from '../lib/hospitals.js';
const { kind='airports', locale='en' } = Astro.props;
const t=getCopy(locale), c=t.directories[kind], w=WAYFINDING_COPY[locale], r=ROOM_COPY[locale], local=p=>localizedPath(p,locale);
const order={room:0,seating:1,planned:2,none:3,pending:4};
const rows=kind==='airports'?[...airports].sort((x,y)=>order[x.status]-order[y.status]||x.iata.localeCompare(y.iata)):kind==='universities'?universities:hospitals;
const regions=kind==='airports'?REGIONS:kind==='universities'?COUNTRIES:H_COUNTRIES;
const filters=kind==='airports'?['room','airside','wudu','women','h24','halal','ask']:kind==='universities'?['wudu','women','jumuah','open']:['musalla','wudu','women','jumuah'];
const g=GUIDE_COPY[locale];
const orientation={
 en:{search:'Start with a name or city. Add the facilities you need.',list:'Compare access & facilities',map:'Find a place by location',guide:'Prepare for your visit',choose:'Explore the directory',help:'Choose a place to open its room locations, access instructions and sources.'},
 fr:{search:'Commencez par un nom ou une ville. Ajoutez les équipements souhaités.',list:'Comparer les accès et équipements',map:'Trouver un lieu sur la carte',guide:'Préparer votre visite',choose:'Explorer l’annuaire',help:'Choisissez un lieu pour consulter ses salles, les conditions d’accès et les sources.'},
 ar:{search:'ابدأ باسم أو مدينة، ثم أضف المرافق التي تحتاجها.',list:'قارن الدخول والمرافق',map:'اعثر على مكان حسب الموقع',guide:'استعد لزيارتك',choose:'استكشف الدليل',help:'اختر مكاناً لعرض مواقع غرف الصلاة وتعليمات الدخول والمصادر.'},
 es:{search:'Empieza por un nombre o una ciudad. Añade los servicios que necesitas.',list:'Comparar acceso y servicios',map:'Encontrar un lugar en el mapa',guide:'Preparar tu visita',choose:'Explorar el directorio',help:'Elige un lugar para consultar sus salas, las condiciones de acceso y las fuentes.'},
}[locale];
const modes=[{id:'list',panel:'list',symbol:'list',title:g.browse,description:orientation.list},{id:'map',panel:'map',symbol:'globe',title:g.map,description:orientation.map},{id:'guide',panel:'guidance',symbol:'book',title:g.notes,description:orientation.guide}];
const countries=[...new Set(rows.map(p=>p.country))].sort((a,b)=>countryName(a,locale).localeCompare(countryName(b,locale),locale));
const icon={airports:'airport',universities:'campus',hospitals:'care'}[kind];
const flyerJump={en:'Explore selected place guides',fr:'Découvrir une sélection de guides',es:'Explorar guías de lugares seleccionados',ar:'استكشف أدلة الأماكن المختارة'}[locale];
const journalLink={en:'Explore all five photographs',fr:'Découvrir les cinq photographies',es:'Explorar las cinco fotografías',ar:'استكشف الصور الخمس'}[locale];
---
<Base title={`${t.nav[kind]} · ${t.common.prayerRooms} | A Room to Pray`} description={c.description} nav={kind}>
  <Fragment slot="arrival">
    <header class="room-directory-intro">
      <div class="directory-intro-copy">
      <span class="room-eyebrow"><span></span>{w.directory}</span>
      <div class="directory-title-line"><span class="category-emblem"><WayfindingSymbol name={icon} size={48}/></span><h1>{w.titles[kind]}</h1></div><p>{c.description}</p>
      <a class="directory-flyer-jump" href="#destination-flyer-heading">{flyerJump}<svg class="directional-icon" width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
      <DirectoryMapPreview places={rows} {locale}/>
    </header>
  </Fragment>
  <div class="wrap room-directory">
    <section class="directory-workspace" id="browse" aria-label={t.common.browse}>
      <div class="controls" data-directory={kind} data-directory-label={c.placesLabel} data-locale={locale}>
        <p class="directory-search-guidance" id="directory-search-guidance">{orientation.search}</p>
        <div class="directory-fields">
          <div class="directory-search-field"><label for="q-dir">{r.search}</label><div class="directory-search-row"><svg width="22" height="22" aria-hidden="true"><use href="#i-search"/></svg><input id="q-dir" type="search" aria-describedby="directory-search-guidance" placeholder={c.searchPlaceholder} autocomplete="off" maxlength="160" /></div></div>
          <label class="directory-country"><span>{t.common.country}</span><select data-directory-country><option value="">{g.countryAll}</option>{countries.map(country=><option value={countryCode(country)}>{countryName(country,locale)}</option>)}</select></label>
        </div>
        <div class="directory-search-meta"><span class="count" id="count" role="status">{formatCount(rows.length,locale)} {c.placesLabel}</span><button class="clear" type="button" id="clear" hidden>{t.common.clear}</button><button class="clear" type="button" data-filter-link hidden>{t.common.copyLink}</button></div>
        <details class="directory-refine"><summary><span><svg width="18" height="18" aria-hidden="true"><use href="#i-filter"/></svg>{r.filters}<span class="filter-count" data-filter-count hidden></span></span><span aria-hidden="true">+</span></summary><div class="filter-panel">
          <div class="seg" hidden={kind!=='airports'} role="group" aria-label={kind==='airports'?t.common.region:t.common.country}><button type="button" data-r="All" aria-pressed="true">{t.common.all}</button>{regions.map(region=><button type="button" data-r={region} aria-pressed="false">{translateTerm(region,locale)}</button>)}</div>
          <div class="row" role="group" aria-label={t.common.filters}>{filters.map(f=><button class="chip" type="button" data-f={f} aria-pressed="false">{t.filters[f]}</button>)}</div><p class="fine">{t.filters.sameRoom}</p>
        </div></details>
        <ul class="active-filters" data-active-filters data-remove-label={t.common.clear} aria-label={t.common.filters} hidden></ul>
        <span class="fine" data-filter-status role="status"></span>
      </div>
      <nav class="guide-tabs directory-mode-tabs" hidden data-directory-mode-controls aria-label={g.overview} role="tablist">
        {modes.map(mode=><button type="button" id={`tab-directory-${mode.id}`} data-directory-mode={mode.id} role="tab" aria-selected={mode.id==='list'?'true':'false'} aria-controls={`directory-${mode.panel}-panel`}><WayfindingSymbol name={mode.symbol} size={38}/><span class="directory-mode-copy"><strong>{mode.title}</strong><small>{mode.description}</small></span><span class="directory-mode-indicator" aria-hidden="true"></span></button>)}
      </nav>
      <p class="directory-access-note"><svg width="18" height="18" aria-hidden="true"><use href="#i-info"/></svg><span>{c.note}</span></p>
      <DirectoryToolbar {locale}/>
      {<div id="directory-map-panel" data-directory-map hidden aria-labelledby="tab-directory-map"><AirportMap {locale} {kind}/></div>}
      <div id="directory-list-panel" data-directory-list-panel aria-labelledby="tab-directory-list">
    <div class="list" id="list"><div class="lrow headrow" aria-hidden="true"><span>{kind==='airports'?'IATA':t.common.country}</span><span>{t.common.name}</span><span class="c-s">{t.common.prayerRooms}</span><span class="c-w">{t.common.wudu}</span><span class="c-f">{t.common.women}</span><span class="q">{t.common.qibla}</span></div>
      {rows.map(p=><DirectoryResult place={p} {kind} {locale} hasHalal={Boolean(halal[p.code]?.outlets.length)}/>)}
      <div class="empty" id="empty" hidden>{t.common.noResults} <button class="clear" type="button" data-clear>{t.common.clear}</button></div>
    </div>
        <nav class="directory-pagination" data-directory-pagination hidden aria-label={r.page}><button type="button" data-page-previous>{r.previous}</button><span data-page-status data-label={r.page} data-of={r.of} role="status"></span><button type="button" data-page-next>{r.next}</button></nav>
      </div>
      <div id="directory-guidance-panel" data-directory-guidance-panel aria-labelledby="tab-directory-guide"><CategoryOrientation {kind} {locale}/><OfficialFieldNote {kind} {locale}/><VisitInsights {kind} {locale} compact /></div>
    </section>
    <DirectoryWayfinding {kind} {locale} places={rows}/>
    <CategoryPhotoEssay {kind} {locale} limit={3}/>
    <a class="directory-journal-link" href={local(`/explore/${kind}/`)}>{journalLink}<svg class="directional-icon" width="22" height="22" aria-hidden="true"><use href="#i-arrow"/></svg></a>
  </div>
</Base>
<script>import '../scripts/directory.js';</script>
<style>
  .directory-journal-link{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:56px;margin-block:-20px 48px;padding:16px 20px;border:1px solid var(--line);border-inline-start:4px solid var(--sign);color:var(--ink);background:var(--surface);font-weight:650;text-underline-offset:5px;line-height:1.5}
  .directory-journal-link svg{flex:none}
  .directory-journal-link:focus-visible{outline:3px solid var(--focus);outline-offset:4px}
  .directory-flyer-jump{display:inline-flex;align-items:center;gap:10px;min-height:44px;margin-top:10px;color:var(--room-inscription);font-size:.875rem;font-weight:600;text-underline-offset:5px;line-height:1.5}
  .directory-flyer-jump svg{flex:none}
  .directory-flyer-jump:focus-visible{outline:3px solid var(--focus);outline-offset:4px}
</style>
