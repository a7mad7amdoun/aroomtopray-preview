---
import Base from '../layouts/Base.astro';
import OfficialFieldNote from './OfficialFieldNote.astro';
import DirectoryPhoto from './DirectoryPhoto.astro';
import DirectoryResult from './DirectoryResult.astro';
import {countryCode,countryName} from '../lib/countries.js';
import {GUIDE_COPY} from '../data/guide-copy.js';
import { ROOM_COPY } from '../data/room-copy.js';
import { WAYFINDING_COPY } from '../data/wayfinding-copy.js';
import VisitInsights from './VisitInsights.astro';
import VisitorArtwork from './VisitorArtwork.astro';
import AirportMap from './AirportMap.astro';
import { getCopy, localizedPath, translateTerm, formatCount } from '../lib/i18n.js';
import { airports, REGIONS, halal } from '../lib/airports.js';
import { universities, COUNTRIES } from '../lib/universities.js';
import { hospitals, H_COUNTRIES } from '../lib/hospitals.js';
const { kind='airports', locale='en' } = Astro.props;
const t=getCopy(locale), c=t.directories[kind], w=WAYFINDING_COPY[locale], r=ROOM_COPY[locale], local=p=>localizedPath(p,locale);
const order={room:0,seating:1,planned:2,none:3,pending:4};
const rows=kind==='airports'?[...airports].sort((x,y)=>order[x.status]-order[y.status]||x.iata.localeCompare(y.iata)):kind==='universities'?universities:hospitals;
const regions=kind==='airports'?REGIONS:kind==='universities'?COUNTRIES:H_COUNTRIES;
const filters=kind==='airports'?['room','airside','wudu','women','h24','halal','ask']:kind==='universities'?['wudu','women','jumuah','open']:['musalla','wudu','women','jumuah'];
const g=GUIDE_COPY[locale];
const countries=[...new Set(rows.map(p=>p.country))].sort((a,b)=>countryName(a,locale).localeCompare(countryName(b,locale),locale));
const icon={airports:'airport',universities:'campus',hospitals:'care'}[kind];
const photoExampleUrl={airports:'/airports/lhr/',universities:'/universities/university-of-warwick/',hospitals:'/hospitals/st-thomas-hospital/'}[kind];
const photoExample=rows.find(place=>place.url===photoExampleUrl);
---
<Base title={`${t.nav[kind]} · ${t.common.prayerRooms} | A Room to Pray`} description={c.description} nav={kind}>
  <Fragment slot="arrival">
    <header class="room-directory-intro">
      <div class="directory-intro-copy">
      <span class="room-eyebrow"><span></span>{w.directory}</span>
      <div class="directory-title-line"><span class="category-emblem"><svg width="28" height="28" aria-hidden="true"><use href={`#i-${icon}`}/></svg></span><h1>{w.titles[kind]}</h1></div><p>{c.description}</p>
      </div>
    </header>
      <div class="controls" data-directory={kind} data-directory-label={c.placesLabel} data-locale={locale}>
        <div class="directory-fields">
          <div class="directory-search-field"><label for="q-dir">{r.search}</label><div class="directory-search-row"><svg width="22" height="22" aria-hidden="true"><use href="#i-search"/></svg><input id="q-dir" type="search" placeholder={c.searchPlaceholder} autocomplete="off" maxlength="160" /></div></div>
          <label class="directory-country"><span>{t.common.country}</span><select data-directory-country><option value="">{g.countryAll}</option>{countries.map(country=><option value={countryCode(country)}>{countryName(country,locale)}</option>)}</select></label>
        </div>
        <div class="directory-search-meta"><span class="count" id="count" role="status">{formatCount(rows.length,locale)} {c.placesLabel}</span><button class="clear" type="button" id="clear" hidden>{t.common.clear}</button><button class="clear" type="button" data-filter-link hidden>{t.common.copyLink}</button></div>
        <details class="directory-refine"><summary><span><svg width="18" height="18" aria-hidden="true"><use href="#i-filter"/></svg>{r.filters}<span class="filter-count" data-filter-count hidden></span></span><span aria-hidden="true">+</span></summary><div class="filter-panel">
          <div class="seg" hidden={kind!=='airports'} role="group" aria-label={kind==='airports'?t.common.region:t.common.country}><button type="button" data-r="All" aria-pressed="true">{t.common.all}</button>{regions.map(region=><button type="button" data-r={region} aria-pressed="false">{translateTerm(region,locale)}</button>)}</div>
          <div class="row" role="group" aria-label={t.common.filters}>{filters.map(f=><button class="chip" type="button" data-f={f} aria-pressed="false">{t.filters[f]}</button>)}</div><p class="fine">{t.filters.sameRoom}</p>
        </div></details>
        <ul class="active-filters" data-active-filters data-remove-label={t.common.clear} aria-label={t.common.filters} hidden></ul>
        <span class="fine" data-filter-status role="status"></span>
      </div>
  </Fragment>
  <div class="wrap room-directory">
    <section class="directory-workspace" id="browse" aria-label={t.common.browse}>
      <nav class="guide-tabs directory-mode-tabs" hidden data-directory-mode-controls aria-label={g.overview} role="tablist"><button type="button" id="tab-directory-list" data-directory-mode="list" role="tab" aria-selected="true" aria-controls="directory-list-panel"><svg width="19" height="19" aria-hidden="true"><use href="#i-list"/></svg><span>{g.browse}</span></button>{kind==='airports'&&<button type="button" id="tab-directory-map" data-directory-mode="map" role="tab" aria-selected="false" aria-controls="directory-map-panel"><svg width="19" height="19" aria-hidden="true"><use href="#i-globe"/></svg><span>{g.map}</span></button>}<button type="button" id="tab-directory-guide" data-directory-mode="guide" role="tab" aria-selected="false" aria-controls="directory-guidance-panel"><svg width="19" height="19" aria-hidden="true"><use href="#i-book"/></svg><span>{g.notes}</span></button></nav>
      <div class="results-toolbar"><h2>{r.results}</h2><div class="browse-tools" data-browse-tools hidden><label class="sr" for="directory-sort">{t.common.sort}</label><select id="directory-sort" data-directory-sort aria-label={t.common.sort}><option value="default">{t.common.recommended}</option><option value="name">{t.common.sortName}</option><option value="location">{t.common.sortLocation}</option></select><div class="seg directory-layout-choice" role="group" aria-label={t.common.view}><button type="button" data-directory-view="list" aria-pressed="true" aria-label={t.common.list} title={t.common.list}><svg width="19" height="19" aria-hidden="true"><use href="#i-list"/></svg></button><button type="button" data-directory-view="cards" aria-pressed="false" aria-label={t.common.cards} title={t.common.cards}><svg width="19" height="19" aria-hidden="true"><use href="#i-grid"/></svg></button></div></div></div>
      {kind==='airports'&&<div id="directory-map-panel" data-directory-map hidden aria-labelledby="tab-directory-map"><AirportMap {locale}/></div>}
      <div id="directory-list-panel" data-directory-list-panel aria-labelledby="tab-directory-list">
    <div class="list" id="list"><div class="lrow headrow" aria-hidden="true"><span>{kind==='airports'?'IATA':t.common.country}</span><span>{t.common.name}</span><span class="c-s">{t.common.prayerRooms}</span><span class="c-w">{t.common.wudu}</span><span class="c-f">{t.common.women}</span><span class="q">{t.common.qibla}</span></div>
      {rows.map(p=><DirectoryResult place={p} {kind} {locale} hasHalal={Boolean(halal[p.code]?.outlets.length)}/>)}
      <div class="empty" id="empty" hidden>{t.common.noResults} <button class="clear" type="button" data-clear>{t.common.clear}</button></div>
    </div>
        <nav class="directory-pagination" data-directory-pagination hidden aria-label={r.page}><button type="button" data-page-previous>{r.previous}</button><span data-page-status data-label={r.page} data-of={r.of} role="status"></span><button type="button" data-page-next>{r.next}</button></nav>
      </div>
      <div id="directory-guidance-panel" data-directory-guidance-panel aria-labelledby="tab-directory-guide"><header class="panel-heading"><span class="guide-kicker">{g.notes}</span><h2>{c.wayfindingTitle}</h2></header><ol class="room-three-steps">{c.steps.map((step,i)=><li><span class="step-symbol"><svg width="23" height="23" aria-hidden="true"><use href={`#i-${['pin','key','water'][i]}`}/></svg></span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol><p class="note">{c.note}</p><OfficialFieldNote {kind} {locale}/><DirectoryPhoto place={photoExample} {locale}/><VisitInsights {kind} {locale} compact /><VisitorArtwork scene={{airports:'airport',universities:'campus',hospitals:'hospital'}[kind]} {locale}/></div>
    </section>

  </div>
</Base>
<script>import '../scripts/directory.js';</script>
