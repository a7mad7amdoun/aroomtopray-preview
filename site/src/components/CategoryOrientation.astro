---
import { getCopy, localeMeta } from '../lib/i18n.js';
import { GUIDE_COPY } from '../data/guide-copy.js';
import { getGuideArtwork } from '../data/guide-artwork.js';
import '../styles/category-orientation.css';

const { kind = 'airports', locale = 'en' } = Astro.props;
const language = localeMeta(locale).code;
const t = getCopy(language);
const category = ['airports', 'universities', 'hospitals'].includes(kind) ? kind : 'airports';
const c = t.directories[category];
const g = GUIDE_COPY[language];
const emblem = { airports: 'airport', universities: 'campus', hospitals: 'care' }[category];
const artwork = getGuideArtwork(category, language);
const symbols = {
  airports: ['search', 'security', 'door-open'],
  universities: ['campus', 'key', 'clock'],
  hospitals: ['pin', 'door-open', 'help'],
}[category];
const headingId = `orientation-${category}`;
---

<section class={`category-orientation category-orientation--${category}`} aria-labelledby={headingId}>
  <header class="orientation-heading">
    <div class="orientation-title-block">
      <div class="orientation-running-line">
        <span class="orientation-category"><svg width="22" height="22" aria-hidden="true"><use href={`#i-${emblem}`}/></svg>{t.nav[category]}</span>
        <span class="orientation-kicker">{g.notes}</span>
      </div>
      <h2 id={headingId}>{c.wayfindingTitle}</h2>
    </div>
    <figure class="orientation-art" data-artwork={artwork.id}>
      <div class="orientation-art-mat">
        <img src={artwork.src} srcset={artwork.srcset} sizes="(max-width: 600px) 85vw, 440px" width={artwork.width} height={artwork.height} alt={artwork.alt} loading="lazy" decoding="async"/>
      </div>
      <figcaption>
        <span class="orientation-art-title" lang="en" dir="ltr"><cite>{artwork.title}</cite>{artwork.artist && <> · {artwork.artist}, {artwork.date}</>}</span>
        {artwork.source ? <a href={artwork.source}>{artwork.credit}<svg width="14" height="14" aria-hidden="true"><use href="#i-arrow"/></svg></a> : <span>{artwork.credit}</span>}
      </figcaption>
    </figure>
  </header>

  <ol class="orientation-steps" role="list">
    {c.steps.map((step, index) => (
      <li>
        <span class="orientation-symbol" aria-hidden="true"><svg width="28" height="28"><use href={`#i-${symbols[index]}`}/></svg></span>
        <h3><span>{step.title}</span></h3>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>

  <div class="orientation-access-note">
    <svg width="21" height="21" aria-hidden="true"><use href="#i-info"/></svg>
    <div><strong>{t.detail.caution}</strong><p>{c.note}</p></div>
  </div>
</section>
