---
import { getCopy, localeMeta, localizedPath } from '../lib/i18n.js';
import { PLACE_PHOTOS } from '../data/place-photos.js';
import { PHOTO_COPY } from '../data/photo-copy.js';
import { photoSrcset } from '../lib/place-photos.js';
import '../styles/category-orientation.css';
import '../styles/category-field-guide.css';
const { kind = 'airports', locale = 'en' } = Astro.props;
const language = localeMeta(locale).code;
const t = getCopy(language);
const category = ['airports', 'universities', 'hospitals'].includes(kind) ? kind : 'airports';
const c = t.directories[category];
const photo = PLACE_PHOTOS.find(photo=>photo.id===({airports:'heathrow-prayer-sign',universities:'warwick-campus-arts-centre',hospitals:'st-thomas-hospital-exterior'}[category]));
const pc=PHOTO_COPY[language];
const headingId = `orientation-${category}`;
const number=new Intl.NumberFormat(language,{minimumIntegerDigits:2});
---
<section class={`category-orientation category-orientation--${category} field-guide`} aria-labelledby={headingId} dir={language==='ar'?'rtl':'ltr'}>
 <header class="field-guide-heading"><h2 id={headingId}>{c.wayfindingTitle}</h2></header>
 <div class="field-guide-body">
  <ol class="field-guide-flow" role="list">
   {c.steps.map((step,index)=><li>
    <span class="field-guide-number" aria-hidden="true">{number.format(index+1)}</span>
    <div class="field-guide-step"><h3>{step.title}</h3><p>{step.text}</p></div>
   </li>)}
  </ol>
  <figure class="field-guide-photo" data-photo-kind={photo.kind}>
   <a class="field-guide-image" href={localizedPath(photo.placeUrl,language)}><img src={photo.images[1].src} srcset={photoSrcset(photo)} sizes="(max-width: 600px) 85vw, 400px" width={photo.width} height={photo.height} alt={photo.alt[language]} loading="lazy" decoding="async"/></a>
   <figcaption>
    <span class="field-guide-photo-kind">{pc.kinds[photo.kind]}</span>
    <p>{photo.caption[language]}</p>
    <span class="field-guide-credit"><a href={photo.sourceUrl}>{photo.author}</a> · <a href={photo.license.url}>{photo.license.name}</a></span>
    {photo.kind==='exterior'&&<p class="field-guide-photo-context">{pc.context}</p>}
    <span class="field-guide-photo-changes">{pc.changes}</span>
   </figcaption>
  </figure>
 </div>
 <aside class="field-guide-caution">
  <svg width="22" height="22" aria-hidden="true"><use href="#i-info"/></svg>
  <div><strong>{t.detail.caution}</strong><p>{c.note}</p></div>
 </aside>
</section>
