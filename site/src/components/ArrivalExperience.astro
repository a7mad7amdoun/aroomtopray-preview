---
import ReceptionCard from './ReceptionCard.astro';
import { ARRIVAL_COPY } from '../data/arrival-copy.js';
import { getCopy, localizedPath } from '../lib/i18n.js';
import { navigationPath } from '../lib/localized-routes.js';
import { airports } from '../lib/airports.js';
import { universities } from '../lib/universities.js';
import { hospitals } from '../lib/hospitals.js';
const { kind='home', locale='en', presentation='home' }=Astro.props;
const q=ARRIVAL_COPY[locale],t=getCopy(locale);
const scene={airports:'airport',universities:'campus',hospitals:'hospital'}[kind]||'airport';
const visual=presentation==='home'||presentation==='directory';
const counts={airports:airports.length,universities:universities.length,hospitals:hospitals.length};
const icons={airports:'airport',universities:'campus',hospitals:'care'};
const number=new Intl.NumberFormat(locale);
---
<section class="arrival-experience" data-arrival-presentation={presentation} data-arrival-kind={kind}>
 <div class="arrival-shell">
  <div class="arrival-copy"><slot />
   <div class="arrival-assistance"><a class="arrival-guide-link" href="#guide-content">{q.guideAction}<svg width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></a><ReceptionCard {locale} id="room-reception"/></div>
  </div>
  {visual&&<figure class="arrival-visual">
    <div class="arrival-image"><img src={`/art/quiet-arrival/${scene}-1086.webp`} srcset={`/art/quiet-arrival/${scene}-720.webp 720w, /art/quiet-arrival/${scene}-1086.webp 1086w`} sizes="(max-width:760px) 100vw, 46vw" width="1086" height="1448" alt="" fetchpriority={presentation==='home'?'high':'auto'} decoding="async"/></div>
    <figcaption><span class="arrival-art-caption">{q.artCaption}</span><small>{q.artLabel}</small></figcaption>
  </figure>}
 </div>
 {presentation==='home'&&<div class="arrival-trust"><svg width="17" height="17" aria-hidden="true"><use href="#i-check"/></svg><p>{q.sourcePromise}</p><a href={navigationPath('/about/',locale)}>{t.nav.about}{locale!=='en'&&<small class="source-language">EN</small>}<span aria-hidden="true"> ↗</span></a></div>}
</section>
{presentation==='home'&&<section class="destination-paths" aria-labelledby="destination-paths-title">
 <header class="destination-paths-heading"><span class="arrival-kicker">{q.settingLabel}</span><h2 id="destination-paths-title">{q.settingsTitle}</h2></header>
 <div class="destination-paths-grid">{Object.keys(counts).map((category,i)=><a class="destination-route" href={localizedPath(`/${category}/`,locale)}>
  <span class="route-top"><span class="route-index" aria-hidden="true">0{i+1}</span><svg class="route-symbol" width="34" height="34" aria-hidden="true"><use href={`#i-${icons[category]}`}/></svg><span class="route-count">{number.format(counts[category])} {t.directories[category].placesLabel}</span></span>
  <span class="route-kicker">{q.categories[category].kicker}</span><h3>{t.nav[category]}</h3><p>{q.categories[category].description}</p>
  <span class="route-action">{q.categories[category].action}<svg class="directional-icon" width="22" height="22" aria-hidden="true"><use href="#i-arrow"/></svg></span>
 </a>)}</div>
</section>}
