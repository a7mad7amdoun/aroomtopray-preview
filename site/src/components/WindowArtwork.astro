---
// Imagined decorative artwork, never evidence of a listed facility.
const { scenes = ['airport', 'campus', 'hospital'] } = Astro.props;
---
<span class="window-wayfinding" aria-hidden="true">
  {scenes.map(scene => <img
    class={`window-illustration window-illustration-${scene}`}
    src={`/art/window-glass/${scene}-v2-360.webp`}
    srcset={`/art/window-glass/${scene}-v2-360.webp 360w, /art/window-glass/${scene}-v2-720.webp 720w`}
    sizes="(max-width: 600px) 120px, 240px"
    width="1086" height="1448" alt="" decoding="async"
  />)}
</span>
