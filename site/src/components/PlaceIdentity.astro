---
import { placeIdentity, neutralPlaceCode } from '../lib/place-identities.js';
const {place,kind,locale='en',compact=false,linked=true,decorative=false}=Astro.props;
const identity=placeIdentity(place,kind);
const labels={en:{official:'Official website',operator:'Operator',trust:'Hospital trust',media:'Official media centre'},fr:{official:'Site officiel',operator:'Exploitant',trust:'Groupe hospitalier',media:'Centre de presse officiel'},ar:{official:'الموقع الرسمي',operator:'الجهة المشغّلة',trust:'المؤسسة الصحية',media:'المركز الإعلامي الرسمي'},es:{official:'Sitio oficial',operator:'Operador',trust:'Grupo hospitalario',media:'Centro de prensa oficial'}};
const t=labels[locale]||labels.en;
const Tag=identity&&linked?'a':'span';
---
<Tag class:list={['place-identity',{'place-identity--compact':compact,'place-identity--neutral':!identity,'place-identity--inverse':identity?.variant==='inverse'}]} href={identity&&linked?identity.officialSourceUrl:undefined} target={identity&&linked?'_blank':undefined} rel={identity&&linked?'noopener noreferrer':undefined} aria-label={identity&&linked?`${identity.name} · ${t.official}`:undefined} data-identity-source={identity?.id}>
 {identity?<>
  <span class="place-identity__plate"><img src={identity.src} width={identity.width} height={identity.height} alt={decorative||linked?'':identity.name} loading="lazy" decoding="async"/></span>
  {identity.scope!=='institution'&&<span class="place-identity__scope">{t[identity.scope]}: <bdi>{identity.name}</bdi></span>}
 </>:<><span class="place-identity__code" aria-hidden="true">{neutralPlaceCode(place,kind)}</span>{!decorative&&<span class="place-identity__name">{place?.name}</span>}</>}
</Tag>
<style>
 .place-identity{display:inline-flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:6px;max-width:160px;flex:none;color:inherit;text-decoration:none;vertical-align:middle;}
 .place-identity__plate{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:132px;height:58px;padding:8px;background:#fff;border:1px solid #dfe3e9;border-radius:5px;}
 .place-identity:not(.place-identity--compact){margin-block-end:12px;}
 .place-identity__plate img{display:block;width:100%;height:100%;object-fit:contain;filter:none;}
 .place-identity--inverse .place-identity__plate{background:#002a5c;}
 .place-identity__scope{font-size:12px;line-height:1.45;text-align:start;max-width:160px;overflow-wrap:break-word;}
 .place-identity__code{font:600 1rem/1.2 var(--f-body);color:var(--muted);letter-spacing:.04em;}
 .place-identity__name{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0;}
 .place-identity--compact{max-width:96px;gap:5px;}
 .place-identity--compact .place-identity__plate{width:80px;height:38px;padding:5px;border-radius:3px;}
 .place-identity--compact .place-identity__scope{font-size:12px;max-width:96px;}
 .place-identity--compact .place-identity__code{font-size:.8rem;}
 a.place-identity:focus-visible{outline:3px solid var(--focus);outline-offset:4px;border-radius:8px;}
 a.place-identity:hover .place-identity__plate{border-color:var(--ink);}
</style>
