---
// The page sprite and standalone wayfinding SVGs share one vector registry.
import { SYMBOLS, symbolMarkup, BRAND_MARK } from '../data/wayfinding-symbols.js';
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    {Object.keys(SYMBOLS).map(name=><symbol id={`i-${name}`} viewBox="0 0 24 24"><Fragment set:html={symbolMarkup(name)}/></symbol>)}
    <symbol id="i-mark" viewBox="0 0 40 40"><Fragment set:html={BRAND_MARK}/></symbol>
  </defs>
</svg>
