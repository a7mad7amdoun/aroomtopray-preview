---
import Base from '../layouts/Base.astro';
import DirectoryPhoto from './DirectoryPhoto.astro';
import { airports, byCode } from '../lib/airports.js';
import { universities } from '../lib/universities.js';
import { hospitals } from '../lib/hospitals.js';
import { QUIET_COPY } from '../data/quiet-copy.js';
import { ATMOSPHERE_COPY } from '../data/room-atmosphere.js';
import DestinationChoices from './DestinationChoices.astro';
import PlaceSearch from './PlaceSearch.astro';
import PrayerRoomBoard from './PrayerRoomBoard.astro';
import GuidePrinciples from './GuidePrinciples.astro';
import { IDENTITY_COPY } from '../data/identity-copy.js';
import VisitInsights from './VisitInsights.astro';
import HomeReferenceSections from './HomeReferenceSections.astro';
import GuideTabNav from './GuideTabNav.astro';
import CountryExplorer from './CountryExplorer.astro';
import { getCopy, localizedPath } from '../lib/i18n.js';
import { ROOM_COPY } from '../data/room-copy.js';
import { GUIDE_COPY } from '../data/guide-copy.js';
const { locale='en' }=Astro.props, t=getCopy(locale), r=ROOM_COPY[locale],g=GUIDE_COPY[locale];
const identity=IDENTITY_COPY[locale], q=QUIET_COPY[locale];
const atmosphere=ATMOSPHERE_COPY[locale];
const allPlaces=[...airports,...universities,...hospitals];
const coverage=new Set(allPlaces.map(place=>place.country)).size;
const number=new Intl.NumberFormat(locale);
const tabs=[{id:'find-place',label:g.find,icon:'search'},{id:'countries',label:g.countryTab,icon:'globe'},{id:'your-visit',label:g.prepare,icon:'book'}];
---
<Base title={`${r.title} ${r.line} | A Room to Pray`} description={t.home.description}>
 <header class="room-home-intro" slot="heading" dir={locale==='ar'?'rtl':'ltr'}>
  <div class="home-title-block"><span class="room-eyebrow"><span></span>{atmosphere.welcome}</span><h1 id="home-title">{atmosphere.invitation.map(line=><span>{line}</span>)}</h1></div>
  <div class="home-welcome-copy"><p class="room-home-line">{r.line}</p><p class="room-introduction">{atmosphere.peace}</p><a class="home-find-link" href="#place-search-input">{r.search}<svg width="20" height="20" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
 </header>
 <Fragment slot="arrival">
  <div class="home-search-primary"><PlaceSearch {locale}/><p class="home-search-intro">{atmosphere.intro}</p></div>
  <dl class="arrival-coverage"><div><dt>{q.listed}</dt><dd>{number.format(allPlaces.length)}</dd></div><div><dt>{q.countries}</dt><dd>{number.format(coverage)}</dd></div></dl>
 </Fragment>
 <div class="wrap guide-home" data-guide-tabs>
  <GuideTabNav {tabs} label={g.overview}/>
  <section id="find-place" class="guide-panel">
<header class="discovery-heading"><div><span class="guide-kicker">{q.boardKicker}</span><h2>{q.boardTitle}</h2></div><p>{q.boardIntro}</p></header>
   <div class="home-departures"><PrayerRoomBoard {locale}/><DirectoryPhoto place={byCode.doh} {locale}/></div>
   <details class="room-disclosure home-photo-library" data-print-expand><summary><span><svg width="19" height="19" aria-hidden="true"><use href="#i-photo"/></svg>{q.photos}</span><span aria-hidden="true">+</span></summary><DestinationChoices {locale}/></details>
   <div class="room-promise room-source-promise"><svg width="19" height="19" aria-hidden="true"><use href="#i-check"/></svg><div><p>{identity.promise}</p><a href="#guide-principles-title">{identity.how}<span aria-hidden="true"> →</span></a></div></div>
  </section>
  <section id="countries" class="guide-panel"><CountryExplorer {locale}/></section>
  <section id="your-visit" class="guide-panel">
   <header class="panel-heading"><span class="guide-kicker">{t.home.stepsEyebrow}</span><h2>{r.source}</h2></header>
   <ol class="room-three-steps">{t.home.steps.map((s,i)=><li><span class="step-symbol"><svg width="23" height="23" aria-hidden="true"><use href={`#i-${['pin','key','water'][i]}`}/></svg></span><h3>{s.title}</h3><p>{s.text}</p></li>)}</ol>
   <a href={localizedPath('/visit/',locale)} class="btn sign-btn">{r.details}<span aria-hidden="true">↗</span></a>
   <GuidePrinciples {locale}/>
   <details class="room-disclosure"><summary>{r.research}<span aria-hidden="true">+</span></summary><VisitInsights {locale}/></details>
   {locale==='en'&&<details class="room-disclosure" data-print-expand><summary>{g.source}<span aria-hidden="true">+</span></summary><HomeReferenceSections/></details>}
  </section>
 </div>
</Base>
