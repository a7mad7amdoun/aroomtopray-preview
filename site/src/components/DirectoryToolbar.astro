---
import { getCopy } from '../lib/i18n.js';
const { locale='en' } = Astro.props;
const t=getCopy(locale);
---
<div class="results-toolbar">
  <div class="browse-tools" data-browse-tools hidden>
    <label class="directory-sort-label" for="directory-sort"><span>{t.common.sort}</span><select id="directory-sort" data-directory-sort><option value="default">{t.common.recommended}</option><option value="name">{t.common.sortName}</option><option value="location">{t.common.sortLocation}</option></select></label>
    <div class="seg directory-layout-choice" role="group" aria-label={t.common.view}>
      <button type="button" data-directory-view="list" aria-pressed="true"><svg width="17" height="17" aria-hidden="true"><use href="#i-list"/></svg><span>{t.common.list}</span></button>
      <button type="button" data-directory-view="cards" aria-pressed="false"><svg width="17" height="17" aria-hidden="true"><use href="#i-grid"/></svg><span>{t.common.cards}</span></button>
    </div>
  </div>
</div>
