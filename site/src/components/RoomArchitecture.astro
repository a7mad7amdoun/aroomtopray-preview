---
import { getCopy } from '../lib/i18n.js';
import RoomLightControls from './RoomLightControls.astro';
import { DOOR_COPY } from '../data/door-copy.js';
import { HOME_VIEW_COPY } from '../data/home-views.js';
import { ATMOSPHERE_COPY } from '../data/room-atmosphere.js';
const { kind='home', locale='en', presentation='home' }=Astro.props;
const t=getCopy(locale), d=DOOR_COPY[locale];
const atmosphere=ATMOSPHERE_COPY[locale];
const settings={airports:'airport', universities:'campus', hospitals:'hospital'};
const scenes=kind in settings?[settings[kind]]:['airport','campus','hospital'];
const outside=settings[kind] || 'airport';
---
  <div class="room-architecture" dir="ltr" data-room-scenery data-architecture="panorama">
   <div class="room-canvas">
    <div class="room-wall" aria-hidden="true"></div>
    {presentation==='home'&&<img class="room-sacred-name" src="/art/calligraphy/allah.svg" alt="الله" lang="ar" width="206" height="218" decoding="async"/>}
    <div class="door-surround room-window-surround">
      <div class="room-window-frame" id="room-panorama">
        <div class={`door-outside outside-${outside}`} role="img" aria-label={`${presentation==='home'?HOME_VIEW_COPY[locale].label:atmosphere.illustration}. ${d.outside}${t.nav[kind in settings?kind:'airports']}`}>
          {scenes.map(scene=><span class={`door-scene door-scene-${scene}`} aria-hidden="true"></span>)}
        </div>
        <span class="room-window-glass" aria-hidden="true"></span>
        <span class="room-window-mullion" aria-hidden="true"></span>
      </div>
    </div>

   </div>
    {presentation==='home'&&<RoomLightControls {locale}/>}
  </div>
