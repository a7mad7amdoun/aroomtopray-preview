---
import { getCopy, localizedPath } from '../lib/i18n.js';
import { HOME_VIEW_COPY } from '../data/home-views.js';
import { ROOM_COPY } from '../data/room-copy.js';
import { DOOR_COPY } from '../data/door-copy.js';
import { QUIET_COPY } from '../data/quiet-copy.js';
import { ATMOSPHERE_COPY } from '../data/room-atmosphere.js';
import { CATEGORY_PHOTOGRAPHY } from '../data/category-photography.js';
import { airports } from '../lib/airports.js';
import { universities } from '../lib/universities.js';
import { hospitals } from '../lib/hospitals.js';
import WayfindingSymbol from './WayfindingSymbol.astro';
import '../styles/destination-gallery.css';

const { kind='home', locale='en', presentation='home' }=Astro.props;
const t=getCopy(locale), r=ROOM_COPY[locale], d=DOOR_COPY[locale], q=QUIET_COPY[locale];
const atmosphere=ATMOSPHERE_COPY[locale];
const settings={airports:'airport', universities:'campus', hospitals:'hospital'};
const doors=[['airports','airport'],['universities','campus'],['hospitals','care']];
const counts={airports:airports.length,universities:universities.length,hospitals:hospitals.length};
const number=new Intl.NumberFormat(locale);
const photos=Object.fromEntries(doors.map(([category])=>[category,CATEGORY_PHOTOGRAPHY[category][0]]));
---
  <div class="room-console destination-gallery" data-room-tour-interaction>
    <aside class="room-wayfinding" dir={locale==='ar'?'rtl':'ltr'} aria-labelledby="room-wayfinding-label">
     <div class="room-console-heading">
      <header class="room-destinations-heading"><p class="room-wayfinding-label" id="room-wayfinding-label">{q.settings}</p></header>
     </div>
      <nav class="door-notices" aria-labelledby="room-wayfinding-label">
        {doors.map(([category,icon])=><div class="door-notice-entry"><a href={localizedPath(`/${category}/`,locale)} class={`door-notice door-notice-${category}`} data-door-destination={category} data-door-preview={settings[category]} data-scene-name={t.nav[category]} data-scene-icon={icon} data-scene-label={`${presentation==='home'?HOME_VIEW_COPY[locale].label:atmosphere.illustration}. ${d.outside}${t.nav[category]}`} data-return-label={d.return} aria-current={kind===category?'location':undefined}>
          {presentation==='home'&&<span class="notice-art"><img src={photos[category].images[1].src} srcset={photos[category].images.map(image=>`${image.src} ${image.width}w`).join(', ')} sizes="(max-width:360px) 90vw, (max-width:760px) 40vw, 33vw" width={photos[category].width} height={photos[category].height} style={`object-position:${photos[category].objectPosition}`} alt="" loading="lazy" decoding="async"/></span>}
          <span class="notice-information"><span class="notice-sign"><span class="door-notice-title"><WayfindingSymbol name={icon} size={32}/><b>{t.nav[category]}</b></span></span>
          <span class="door-notice-count"><strong>{number.format(counts[category])}</strong>{' '}<span>{r.places}</span><span class="door-current-dot" aria-hidden="true"></span></span>
          {kind===category&&<span class="sr">{d.current}</span>}
          <span class="door-notice-return" data-door-return-label hidden></span>
          {presentation==='home'&&<><span class="notice-description">{q.categories[category].text}</span><span class="notice-action">{t.directories[category].action}<svg width="20" height="20" class="notice-arrow directional-icon" aria-hidden="true"><use href="#i-arrow"/></svg></span></>}</span>
        </a>{presentation==='home'&&<details class="destination-credit"><summary>{atmosphere.photo}</summary><p class="notice-photo-credit"><span><a href={photos[category].sourceUrl} lang="en">{photos[category].title}</a></span><span><bdi>{photos[category].author}</bdi> · <time datetime={photos[category].date}>{photos[category].date.slice(0,4)}</time> · <a href={photos[category].license.url}>{photos[category].license.name}</a></span><span>{atmosphere.examples}</span></p></details>}</div>)}
      </nav>
    </aside>
  </div>
