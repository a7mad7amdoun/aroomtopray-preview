---
import { CATEGORY_PHOTOGRAPHY } from '../data/category-photography.js';
import { countryName } from '../lib/countries.js';
import { localizedPath } from '../lib/i18n.js';
const {kind='airports',locale='en',places=[]}=Astro.props;
const local=path=>localizedPath(path,locale);
// The hospital feature pairs a planted courtyard with an urban hospital campus.
const photos=kind==='hospitals'
 ? ['ktph-bridge','berlin-hospital'].map(id=>CATEGORY_PHOTOGRAPHY[kind].find(photo=>photo.id===id)).filter(Boolean)
 : CATEGORY_PHOTOGRAPHY[kind].slice(0,2);
const selected={airports:['LHR','AMS','SIN'],universities:['university-of-warwick','university-of-toronto','university-of-melbourne'],hospitals:['st-thomas-hospital','toronto-general','houston-methodist-tmc']}[kind];
const featured=selected.map(id=>places.find(place=>(place.iata||place.slug)===id)).filter(Boolean);
const photoGuides={'bangkok-terminal':'/airports/bkk/','toronto-terminal':'/airports/yyz/','toronto-campus':'/universities/university-of-toronto/'};
const c={
 en:{eyebrow:'A closer look',title:{airports:'Between departures.',universities:'Within campus life.',hospitals:'A moment within the day.'},journal:'Explore the photographic journal',guides:'Selected place guides',open:'Open guide',source:'Original photograph',official:'Official website',context:'Architecture and surroundings, not evidence of a prayer room or current access.',changes:'Photographs resized for display; no generated imagery.'},
 fr:{eyebrow:'Un autre regard',title:{airports:'Entre deux départs.',universities:'Au cœur du campus.',hospitals:'Un moment dans la journée.'},journal:'Explorer le carnet photographique',guides:'Une sélection de guides',open:'Ouvrir le guide',source:'Photographie originale',official:'Site officiel',context:'Architecture et environnement : ces vues ne confirment ni salle de prière ni accès actuel.',changes:'Photographies redimensionnées pour l’affichage ; aucune image générée.'},
 es:{eyebrow:'Una mirada más cercana',title:{airports:'Entre salidas.',universities:'En la vida del campus.',hospitals:'Un momento en el día.'},journal:'Explorar el diario fotográfico',guides:'Guías de lugares seleccionados',open:'Abrir guía',source:'Fotografía original',official:'Sitio oficial',context:'Arquitectura y entorno: estas vistas no confirman una sala de oración ni el acceso actual.',changes:'Fotografías redimensionadas para su presentación; sin imágenes generadas.'},
 ar:{eyebrow:'نظرة أقرب',title:{airports:'بين رحلتين.',universities:'في قلب الحياة الجامعية.',hospitals:'لحظة في ثنايا اليوم.'},journal:'استكشف الدفتر المصوّر',guides:'أدلة أماكن مختارة',open:'افتح الدليل',source:'الصورة الأصلية',official:'الموقع الرسمي',context:'صور للعمارة والمحيط، وليست دليلًا على وجود غرفة صلاة أو شروط الدخول الحالية.',changes:'تم تغيير حجم الصور للعرض؛ لا صور مولّدة.'},
}[locale];
---
<section id="destination-flyer-heading" class={`category-editorial category-editorial--${kind}`} aria-labelledby="category-editorial-title" dir={locale==='ar'?'rtl':'ltr'}>
 <header class="editorial-heading">
  <div><p class="editorial-eyebrow">{c.eyebrow}</p><h2 id="category-editorial-title">{c.title[kind]}</h2></div>
  <a class="editorial-journal" href={local(`/explore/${kind}/`)}>{c.journal}<svg class="directional-icon" width="24" height="24" aria-hidden="true"><use href="#i-arrow"/></svg></a>
 </header>
 <div class="editorial-spread">
  {photos.map((photo,index)=>{
   const destination=photoGuides[photo.id]?local(photoGuides[photo.id]):photo.officialUrl;
   return <figure class:list={['editorial-photograph',{'editorial-photograph--lead':index===0}]}>
    <a class="editorial-image" href={photo.sourceUrl} aria-label={`${c.source}: ${photo.title}`}><img src={photo.images[1].src} srcset={photo.images.map(image=>`${image.src} ${image.width}w`).join(', ')} sizes={index===0?'(max-width:700px) 92vw, 60vw':'(max-width:700px) 72vw, 30vw'} width={photo.width} height={photo.height} alt={photo.alt[locale]||photo.alt.en} loading="lazy" decoding="async"/></a>
    <figcaption>
     <div class="editorial-place-line"><h3 lang="en" dir="auto">{photo.title}</h3>{destination&&<a href={destination} aria-label={`${photo.title} · ${photoGuides[photo.id]?c.open:c.official}`}><svg class="directional-icon" width="20" height="20" aria-hidden="true"><use href="#i-arrow"/></svg></a>}</div>
     <p>{photo.caption[locale]||photo.caption.en}</p>
     <div class="editorial-credit"><a href={photo.sourceUrl}><bdi>{photo.author}</bdi></a><span aria-hidden="true"> · </span><time datetime={photo.date}>{photo.date.slice(0,4)}</time><span aria-hidden="true"> · </span><a href={photo.license.url} lang="en">{photo.license.name}</a></div>
    </figcaption>
   </figure>;
  })}
  <nav class="editorial-guides" aria-labelledby="editorial-guides-title">
   <h3 id="editorial-guides-title">{c.guides}</h3>
   <ul>{featured.map(place=><li><a href={local(place.url)}>{place.iata&&<bdi class="editorial-iata">{place.iata}</bdi>}<span><strong dir="auto">{place.name}</strong><small><bdi>{place.city}</bdi> · {countryName(place.country,locale)}</small></span><svg class="directional-icon" width="20" height="20" aria-hidden="true"><use href="#i-arrow"/></svg></a></li>)}</ul>
  </nav>
 </div>
 <p class="editorial-context">{c.context} {c.changes}</p>
</section>
<style>
 .category-editorial{container:category-editorial/inline-size;margin-block:clamp(40px,6vw,84px);color:var(--ink);min-width:0;--editorial-rule:var(--category-rule,var(--line))}
 .editorial-heading{display:flex;align-items:end;justify-content:space-between;gap:24px 48px;padding-block:24px 30px;border-top:3px solid var(--editorial-rule)}
 .editorial-eyebrow{font-size:.78rem;font-weight:650;letter-spacing:.05em;margin:0 0 12px;color:var(--muted)}
 .editorial-heading h2{font:750 clamp(2.1rem,4.2vw,4rem)/1.08 var(--f-body);letter-spacing:-.045em;max-width:18ch;text-wrap:balance;margin:0}
 .editorial-journal{display:flex;align-items:center;justify-content:space-between;gap:18px;max-width:290px;min-height:48px;line-height:1.5;color:inherit;font-size:.9rem;font-weight:650;text-decoration:none;border-bottom:1px solid var(--editorial-rule);padding-block:10px}
 .editorial-journal svg{box-sizing:content-box;padding:8px;background:var(--sign);color:var(--sign-ink);flex:none}
 .editorial-spread{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(0,1fr);gap:24px 36px;align-items:start}
 .editorial-photograph{margin:0;min-width:0}
 .editorial-photograph--lead{grid-column:1;grid-row:1/3}
 .editorial-image{display:block;background:var(--surface-2);line-height:0}
 .editorial-image img{display:block;width:100%;height:auto;filter:none}
 .category-editorial--hospitals .editorial-photograph--lead .editorial-image{aspect-ratio:4/5;overflow:hidden}
 .category-editorial--hospitals .editorial-photograph--lead .editorial-image img{height:100%;object-fit:cover;object-position:50% 45%}
 figcaption{padding-top:15px}
 .editorial-place-line{display:flex;align-items:start;justify-content:space-between;gap:12px}
 .editorial-place-line h3{font:650 1rem/1.45 var(--f-body);margin:0;min-width:0}
 .editorial-photograph--lead .editorial-place-line h3{font-size:1.2rem}
 .editorial-place-line>a{display:grid;place-items:center;min-width:44px;min-height:44px;color:inherit;flex:none;margin-top:-10px}
 figcaption p{font-size:.875rem;line-height:1.65;margin:8px 0 10px;max-width:66ch;color:var(--muted)}
 .editorial-credit{font-size:.75rem;line-height:1.65;color:var(--muted)}
 .editorial-credit a{color:inherit;text-underline-offset:4px}
 .editorial-guides{grid-column:2;padding-top:20px;border-top:2px solid var(--editorial-rule);min-width:0}
 .editorial-guides h3{font-size:.8rem;font-weight:650;line-height:1.5;margin:0 0 12px;color:var(--muted)}
 .editorial-guides ul{list-style:none;margin:0;padding:0}
 .editorial-guides li+li{border-top:1px solid var(--line)}
 .editorial-guides a{display:flex;align-items:center;gap:12px;padding:14px 0;min-height:64px;color:inherit;text-decoration:none}
 .editorial-guides a>span{display:grid;gap:4px;min-width:0;flex:1}
 .editorial-guides strong{font-size:.95rem;line-height:1.45;font-weight:650;overflow-wrap:break-word}
 .editorial-guides small{font-size:.75rem;line-height:1.5;color:var(--muted)}
 .editorial-guides svg{flex:none}
 .editorial-iata{font:650 .9rem/1.3 var(--f-mono,monospace);letter-spacing:.04em;min-width:3.3em;color:var(--category-accent,var(--ink));background:var(--category-panel);text-align:center;padding:8px 4px;flex:none}
 .editorial-context{border-top:1px solid var(--line);padding-top:16px;margin:24px 0 0;max-width:100ch;font-size:.78rem;line-height:1.7;color:var(--muted)}
 .category-editorial a:focus-visible{outline:3px solid var(--focus);outline-offset:4px}
 .editorial-guides a:hover strong,.editorial-journal:hover{text-decoration:underline;text-underline-offset:5px}
 .category-editorial--universities .editorial-heading{border-top:4px double var(--editorial-rule)}
 .category-editorial--universities .editorial-heading h2{font-family:'Room Invitation',Georgia,serif;font-weight:500;letter-spacing:-.025em;line-height:1.15}
 .category-editorial--hospitals .editorial-heading h2{font-weight:650;letter-spacing:-.035em;line-height:1.15}
 .category-editorial--hospitals .editorial-guides{border-top:3px solid var(--category-accent)}
 [dir=rtl] .editorial-heading h2{font-family:var(--f-arabic);line-height:1.5;letter-spacing:0}
 [dir=rtl] .editorial-eyebrow{letter-spacing:0}
 @container category-editorial (max-width:700px){.editorial-heading{align-items:start;flex-direction:column;gap:18px;padding-block:20px 24px}.editorial-journal{max-width:none;width:100%}.editorial-spread{grid-template-columns:1fr;gap:28px}.editorial-photograph--lead{grid-column:1;grid-row:auto}.editorial-photograph:not(.editorial-photograph--lead){width:80%;justify-self:end}.editorial-guides{grid-column:1}.editorial-guides a{padding-block:16px}.editorial-heading h2{max-width:20ch}.editorial-context{margin-top:20px}}
 @media print{.editorial-photograph,.editorial-guides{break-inside:avoid}}
</style>
