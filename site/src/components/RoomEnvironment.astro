---
import RoomDestinations from './RoomDestinations.astro';
import ReceptionCard from './ReceptionCard.astro';
import RoomArchitecture from './RoomArchitecture.astro';
import RoomSceneControls from './RoomSceneControls.astro';
import RoomViewCredits from './RoomViewCredits.astro';
import RoomLightControls from './RoomLightControls.astro';
import { QUIET_COPY } from '../data/quiet-copy.js';
const { kind='home', locale='en', presentation='home' }=Astro.props;
const q=QUIET_COPY[locale];
const settings={airports:'airport', universities:'campus', hospitals:'hospital'};
const outside=settings[kind] || 'airport';
---
<div id="prayer-room" class="room-environment" data-room-presentation={presentation} data-room-preview={outside} data-room-setting={kind}>
 <div class="room-layout">
  <main id="main" class="room-main" tabindex="-1">
   <div class="room-stage">
    <slot name="heading" />
    <div class="room-arrival-copy" dir={locale==='ar'?'rtl':'ltr'}>
     <slot name="arrival" />
     <div class="arrival-actions">
      <ReceptionCard {locale} id="room-reception"/>
      {presentation!=='home'&&<a class="arrival-guide-link" href="#guide-content">{q.guide}<svg width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></a>}
     </div>
    </div>
    <RoomArchitecture {kind} {locale} {presentation}/>
    <div class="room-scene-tools" data-room-tour-interaction>
     <RoomSceneControls {kind} {locale} {presentation}/>
     <RoomLightControls {locale}/>
     <RoomViewCredits {kind} {locale} {presentation}/>
    </div>
   </div>
   {presentation==='home'&&<RoomDestinations {kind} {locale} {presentation}/>}
   <slot name="guide" />
  </main>
 </div>
</div>
<script>
 import '../scripts/room-door.js';
 import '../scripts/room-focus.js';
 import '../scripts/room-motion.js';
</script>
