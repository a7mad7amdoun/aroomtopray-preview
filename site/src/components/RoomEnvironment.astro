---
import { getCopy, localizedPath } from '../lib/i18n.js';
import { ROOM_COPY } from '../data/room-copy.js';
import { DOOR_COPY } from '../data/door-copy.js';
import ReceptionCard from './ReceptionCard.astro';
import { QUIET_COPY } from '../data/quiet-copy.js';
import { ATMOSPHERE_COPY, SETTING_PHOTOS, SETTING_PHOTO_LICENSE } from '../data/room-atmosphere.js';
import { airports } from '../lib/airports.js';
import { universities } from '../lib/universities.js';
import { hospitals } from '../lib/hospitals.js';
const { kind='home', locale='en', presentation='home' }=Astro.props;
const t=getCopy(locale), r=ROOM_COPY[locale], d=DOOR_COPY[locale], q=QUIET_COPY[locale];
const atmosphere=ATMOSPHERE_COPY[locale];
const settings={airports:'airport', universities:'campus', hospitals:'hospital'};
const open=kind in settings || presentation==='home';
const scenes=kind in settings?[settings[kind]]:['airport','campus','hospital'];
const outside=settings[kind] || 'airport';
const doors=[['airports','airport'],['universities','campus'],['hospitals','care']];
const counts={airports:airports.length,universities:universities.length,hospitals:hospitals.length};
const number=new Intl.NumberFormat(locale);
---
<div id="prayer-room" class:list={['room-environment', {'room-door-open':open}]} data-room-presentation={presentation} data-room-preview={outside} data-room-setting={kind} data-door-state={open?'open':'closed'}>
  <div class="room-architecture" dir="ltr" data-room-scenery>
   <div class="room-canvas">
    <div class="room-wall" aria-hidden="true"></div>
    <div class="door-surround">
          <span class="door-room-sign" dir={locale==='ar'?'rtl':'ltr'}><svg width="20" height="20" aria-hidden="true"><use href="#i-mark"/></svg><b>{r.room}</b></span>
      <div class="door-frame" id="room-doorway">
        <div class={`door-outside outside-${outside}`} role="img" aria-label={`${atmosphere.illustration}. ${d.outside}${t.nav[kind in settings?kind:'airports']}`}>
          {scenes.map(scene=><span class={`door-scene door-scene-${scene}`} aria-hidden="true"></span>)}
        </div>
        <span class="door-floor-light" aria-hidden="true"></span>
        <span class="door-swing-shadow" aria-hidden="true"></span>
        <div class="door-leaf" aria-hidden="true">
          <span class="door-skin"></span>
          <div class="door-window">
            <span class="door-clear-glass"></span>
            <span class="window-reflection"></span>
          </div>
          <span class="door-handle" aria-hidden="true"></span>
          <span class="door-kickplate" aria-hidden="true"></span>
          <span class="door-hinge door-hinge-top"></span><span class="door-hinge door-hinge-bottom"></span>
        </div>

      </div>

    </div>

   </div>
    <p class="room-art-note">{atmosphere.illustration}</p>
  </div>
 <div class="room-layout">
  <main id="main" class="room-main" tabindex="-1">
   <div class="room-control-bar" dir={locale==='ar'?'rtl':'ltr'}>
        <button class="door-control" dir={locale==='ar'?'rtl':'ltr'} type="button" hidden data-door-toggle data-open-label={d.open} data-close-label={d.close} aria-controls="room-doorway" aria-expanded={String(open)}>
          <span class="door-action-caption"><svg class="door-icon-closed" width="17" height="17" aria-hidden="true"><use href="#i-door-closed"/></svg><svg class="door-icon-open" width="17" height="17" aria-hidden="true"><use href="#i-door-open"/></svg>
          <span data-door-toggle-label>{open?d.close:d.open}</span></span>
        </button>
    <div class="room-location" dir={locale==='ar'?'rtl':'ltr'}>

        <div class="room-light" hidden data-room-light-control>
          <button type="button" class="light-switch" data-room-light aria-describedby="room-light-state" aria-label={r.light} aria-pressed="true" title={r.light}><span class="switch-rocker" aria-hidden="true"><svg class="light-icon-sun" width="17" height="17"><use href="#i-sun"/></svg><svg class="light-icon-moon" width="17" height="17"><use href="#i-moon"/></svg></span></button>
          <small id="room-light-state" data-room-light-state data-light={r.on} data-dark={r.off}></small>
          <span class="sr" data-room-light-status role="status"></span>
        </div>
      </div>
   </div>
   <div class="room-stage">
    <div class="room-arrival-copy" dir={locale==='ar'?'rtl':'ltr'}><slot name="arrival" /><div class="arrival-actions"><ReceptionCard {locale} id="room-reception"/><a class="arrival-guide-link" href="#guide-content">{q.guide}<svg width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></a></div></div>
   </div>
  <div class="room-console" data-room-tour-interaction>
    <div class="room-atmosphere-controls" dir={locale==='ar'?'rtl':'ltr'}>
      <p class="room-scene-caption"><svg width="17" height="17" aria-hidden="true"><use data-room-scene-icon href={`#i-${doors.find(([category])=>category===kind)?.[1]||'airport'}`}/></svg><span>{d.outside}<b data-room-scene-name>{t.nav[kind in settings?kind:'airports']}</b></span></p>
      {presentation==='home'&&<button type="button" hidden data-room-cycle data-pause-label={atmosphere.pause} data-resume-label={atmosphere.resume} data-paused-message={atmosphere.paused} data-playing-message={atmosphere.playing} aria-controls="room-doorway"><svg class="room-cycle-icon" width="15" height="15" viewBox="0 0 20 20" aria-hidden="true"><path class="cycle-pause" d="M6 4v12M14 4v12" fill="none" stroke="currentColor" stroke-width="3"/><path class="cycle-play" d="m6 3 10 7-10 7z" fill="currentColor"/></svg><span data-room-cycle-label>{atmosphere.pause}</span></button>}
      <span class="sr" data-room-cycle-status role="status"></span>
    </div>

    <aside class="room-wayfinding" dir={locale==='ar'?'rtl':'ltr'} aria-labelledby="room-wayfinding-label">
      <header class="room-destinations-heading"><div><p class="room-wayfinding-label" id="room-wayfinding-label">{q.settings}</p>{presentation==='home'&&<h2>{q.choose}</h2>}</div>{presentation==='home'&&<span class="room-illustration-label">{atmosphere.examples}</span>}</header>
      <nav class="door-notices" aria-labelledby="room-wayfinding-label">
        {doors.map(([category,icon])=><div class="door-notice-entry"><a href={localizedPath(`/${category}/`,locale)} class={`door-notice door-notice-${category}`} data-door-destination={category} data-door-preview={settings[category]} data-scene-name={t.nav[category]} data-scene-icon={icon} data-scene-label={`${atmosphere.illustration}. ${d.outside}${t.nav[category]}`} data-return-label={d.return} aria-current={kind===category?'location':undefined}>
          {presentation==='home'&&<span class="notice-art"><img src={`/photos/settings/${settings[category]}-1440.webp`} srcset={`/photos/settings/${settings[category]}-720.webp 720w, /photos/settings/${settings[category]}-1440.webp 1440w, /photos/settings/${settings[category]}-2160.webp 2160w`} sizes="(max-width:600px) 88px, (max-width:1100px) 28vw, 12vw" width={SETTING_PHOTOS[settings[category]].width} height={SETTING_PHOTOS[settings[category]].height} alt="" loading="lazy" decoding="async"/><span class="notice-number" aria-hidden="true">{String(doors.findIndex(([c])=>c===category)+1).padStart(2,'0')}</span></span>}
          <span class="notice-information"><span class="notice-kicker">{q.categories[category].kicker}</span><span class="door-notice-title"><svg width="18" height="18" aria-hidden="true"><use href={`#i-${icon}`}/></svg><b>{t.nav[category]}</b><svg class="notice-arrow" width="16" height="16" aria-hidden="true"><use href="#i-arrow"/></svg></span>
          <span class="door-notice-count"><strong>{number.format(counts[category])}</strong>{' '}<span>{r.places}</span><span class="door-current-dot" aria-hidden="true"></span></span>
          {kind===category&&<span class="sr">{d.current}</span>}
          <span class="door-notice-return" data-door-return-label hidden></span>
          {presentation==='home'&&<span class="notice-description">{q.categories[category].text}</span>}</span>
        </a>{presentation==='home'&&<p class="notice-photo-credit"><span>{atmosphere.photo}: <a href={SETTING_PHOTOS[settings[category]].source} lang="en">{SETTING_PHOTOS[settings[category]].name}</a></span><span><bdi>{SETTING_PHOTOS[settings[category]].author}</bdi> · <time datetime={SETTING_PHOTOS[settings[category]].date}>{SETTING_PHOTOS[settings[category]].date.slice(0,4)}</time> · <a href={SETTING_PHOTO_LICENSE}>CC BY-SA 4.0</a></span></p>}</div>)}
      </nav>
    </aside>
  </div>
   <slot name="guide" />
  </main>
 </div>
</div>
<script>
 import '../scripts/room-door.js';
 import '../scripts/room-focus.js';
 import '../scripts/room-motion.js';
</script>
