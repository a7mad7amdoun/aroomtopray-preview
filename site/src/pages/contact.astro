---
import Turnstile from '../components/Turnstile.astro';
import Base from '../layouts/Base.astro';
import EditorialArtwork from '../components/EditorialArtwork.astro';
---
<Base title="Contact A Room to Pray" description="Corrections, airport updates, press and other questions for A Room to Pray." nav="contact">
  <Fragment slot="arrival"><header class="support-arrival">
      <span class="eyebrow">Contact</span>
      <h1>Write to the editor.</h1>
      <p>Messages go to Hamza Abdul-Tawwaab, the editor. For a change to one airport, the report form on that airport’s page is quickest. Airports, chaplaincies and journalists are welcome to write here.</p>
  </header></Fragment>
  <div class="wrap">
    <div class="prose">
      <form class="contact-form" method="post" action="/api/contact" data-contact>
        <label>What it’s about<select name="topic" required><option>A correction</option><option>I work at an airport or chaplaincy</option><option>Press</option><option>Something else</option></select></label>
        <label>Your message<textarea name="message" rows="6" required minlength="10" maxlength="3000"></textarea></label>
        <label>Your email (optional, only if you want a reply)<input name="email" type="email" maxlength="200" autocomplete="email"></label>
        <label class="hp" aria-hidden="true">Leave empty<input name="website" tabindex="-1" autocomplete="off"></label>
        <Turnstile />
        <div><button class="btn" type="submit">Send message</button></div>
      </form>
      <div class="ok" hidden data-ok><svg width="20" height="20" aria-hidden="true"><use href="#i-check"/></svg>Thanks. Your message has reached the editor.</div>
      <p class="err" hidden data-err role="alert">Your message didn’t send. Check your connection and try again; your text is still here.</p>
      <p class="fine">We use your email only to reply, and delete messages after 180 days. See <a href="/about/#privacy">privacy</a>.</p>
      <EditorialArtwork placement="supporting"/>
    </div>
  </div>
</Base>
<script>
  const form = document.querySelector('[data-contact]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button'), ok = document.querySelector('[data-ok]'), err = document.querySelector('[data-err]');
    btn.disabled = true; err.hidden = true;
    try {
      const r = await fetch('/api/contact', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
      if (!r.ok) throw new Error(String(r.status));
      form.hidden = true; ok.hidden = false;
    } catch { err.hidden = false; btn.disabled = false; window.turnstile?.reset(form.querySelector('.cf-turnstile')); }
  });
</script>
