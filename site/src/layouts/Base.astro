---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/noto-naskh-arabic/600.css';
import '@fontsource/noto-naskh-arabic/400.css';
import '../styles/global.css';
import '../styles/improvements.css';
import '../styles/experience.css';
import '../styles/sanctuary.css';
import '../styles/immersive-room.css';
import '../styles/room-guide.css';
import '../styles/room-artwork.css';
import '../styles/editorial-art.css';
import '../styles/countries.css';
import '../styles/room-door.css';
import '../styles/information-design.css';
import '../styles/modern-room.css';
import '../styles/room-spatial.css';
import '../styles/premium-navigation.css';
import '../styles/room-backdrop.css';
import '../styles/room-palette.css';
import HeaderNavigation from '../components/HeaderNavigation.astro';
import RoomEnvironment from '../components/RoomEnvironment.astro';
import SourceProvenance from '../components/SourceProvenance.astro';
import { LOCALES, getCopy, localeFromPath, localeMeta, localizedPath } from '../lib/i18n.js';
import { hasLocalizedRoute, navigationPath } from '../lib/localized-routes.js';
import Icons from '../components/Icons.astro';
import Mark from '../components/Mark.astro';
import { SITE } from '../lib/airports.js';
import { DOOR_ARRIVAL_PREPAINT_SCRIPT } from '../lib/door-arrival.js';

interface Props { title: string; description: string; nav?: string; noindex?: boolean; og?: string | null; jsonld?: object; destinationNav?: boolean }
const { title, description, nav = '', noindex = false, og = null, jsonld, destinationNav = true } = Astro.props;
const reviewPreview = import.meta.env.PUBLIC_REVIEW_PREVIEW === 'true';
const locale = localeFromPath(Astro.url.pathname);
const t = getCopy(locale);
const visitHash = ['airports','universities','hospitals'].includes(nav) ? `#panel-${nav}` : '';
const roomKind = ['airports','universities','hospitals'].includes(nav) ? nav : 'home';
const local = path => navigationPath(path, locale);
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = new URL(og || '/og/default.jpg', SITE).href;
const isHome = Astro.url.pathname.replace(/^\/(fr|ar|es)/,'').replace(/\/$/,'') === '';
const isDirectory = ['airports','universities','hospitals'].includes(nav) && Astro.url.pathname.replace(/^\/(fr|ar|es)/,'').replace(/\/$/,'') === `/${nav}`;
const presentation = isHome ? 'home' : isDirectory ? 'directory' : roomKind !== 'home' ? 'detail' : 'support';
const searchTarget = isHome ? '#place-search-input' : isDirectory ? '#q-dir' : `${localizedPath('/',locale)}#place-search-input`;
---
<!doctype html>
<html lang={locale} dir={localeMeta(locale).dir} data-sector={nav || 'home'}>
<head>
  <meta charset="utf-8">
  <script is:inline>document.documentElement.classList.add('js'); try { const theme = localStorage.getItem('aroomtopray.theme.v1'); if (theme === 'light' || theme === 'dark') document.documentElement.setAttribute('data-theme', theme); } catch {} try { sessionStorage.removeItem('aroomtopray.focus.v2'); sessionStorage.removeItem('aroomtopray.focus.v1'); } catch {}</script>
  <script is:inline set:html={DOOR_ARRIVAL_PREPAINT_SCRIPT}/>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {hasLocalizedRoute(Astro.url.pathname) && LOCALES.map(l => <link rel="alternate" hreflang={l.code} href={new URL(localizedPath(Astro.url.pathname, l.code), SITE).href} />)}
  {hasLocalizedRoute(Astro.url.pathname) && <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(Astro.url.pathname, 'en'), SITE).href} />}
  {(noindex || reviewPreview) && <meta name="robots" content="noindex">}
  <meta name="theme-color" content="#FFC629">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="A Room to Pray">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body class="immersive-site">
  {reviewPreview && <aside class="review-preview-notice" style="padding:7px 16px;text-align:center;font-size:12px;background:#111b2a;color:#f7f6f0;position:relative;z-index:5" aria-label="Review preview">{{en:'Design preview for Hamza · Forms, check-ins and uploads are disabled.',fr:'Aperçu pour Hamza · Formulaires, signalements de présence et envois désactivés.',ar:'معاينة التصميم لحمزة · النماذج وتسجيل الزيارات ورفع الصور معطّلة.',es:'Vista previa para Hamza · Formularios, registros de visitas y cargas desactivados.'}[locale]}</aside>}
  <a class="skip" href="#main">{t.nav.skip}</a>
  <Icons />
  <HeaderNavigation {locale} {nav} {searchTarget} {visitHash}/>
  <script>import '../scripts/navigation.js';</script>
  <RoomEnvironment kind={roomKind} {locale} {presentation}>
    <Fragment slot="arrival"><slot name="arrival" /></Fragment>
    <div id="guide-content" class="guide-content" slot="guide">
      <slot name="welcome" />
      <slot />
      <div class="guide-source-credit"><SourceProvenance path={Astro.url.pathname} {locale}/></div>
    </div>
  </RoomEnvironment>
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div class="footer-about stack"><a class="brand" href={localizedPath('/', locale)}><Mark size={28} />A Room to Pray</a><p>{t.footer.statement}</p><span class="fine">{t.footer.description}</span></div>
      <nav aria-label={t.footer.directories}><h2>{t.footer.directories}</h2>{['airports', 'universities', 'hospitals'].map(k => <a href={local(`/${k}/`)}>{t.nav[k]}</a>)}<a href="/saved/">{t.nav.saved}{locale !== 'en' && <small class="source-language">EN</small>}</a></nav>
      <nav aria-label={t.footer.prepare}><h2>{t.footer.prepare}</h2><a href={local('/visit/')+visitHash}>{t.home.stepsEyebrow}</a><a href="/planner/">{t.nav.planner}{locale !== 'en' && <small class="source-language">EN</small>}</a><a href="/travel/">{t.nav.travel}{locale !== 'en' && <small class="source-language">EN</small>}</a><a href="/rooms-won/">{t.nav.roomsWon}{locale !== 'en' && <small class="source-language">EN</small>}</a></nav>
      <nav aria-label={t.footer.project}><h2>{t.footer.project}</h2><a href="/about/">{t.nav.about}{locale !== 'en' && <small class="source-language">EN</small>}</a><a href="/contact/">{t.nav.contact}{locale !== 'en' && <small class="source-language">EN</small>}</a><a href="/about/#privacy">{t.footer.privacy}{locale !== 'en' && <small class="source-language">EN</small>}</a><a href="/terms/">{t.footer.terms}{locale !== 'en' && <small class="source-language">EN</small>}</a></nav>
    </div>
    <div class="wrap footer-bottom"><p>{t.footer.sourceNote}</p><p>Inheriting Islam · <a href="https://lifeistemporary.com/">Life Is Temporary</a> · <a href="https://firstadhan.com/">First Adhān</a></p></div>
  </footer>
  {import.meta.env.PROD && !reviewPreview && <script is:inline>
    // One count per page view: the page, the day and the approximate city (functions/api/visit.js). No cookies.
    if (navigator.sendBeacon && !navigator.webdriver) navigator.sendBeacon('/api/visit', JSON.stringify({ p: location.pathname, r: document.referrer }));
  </script>}
</body>
</html>
